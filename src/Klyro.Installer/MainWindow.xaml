<Window x:Class="Klyro.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klyro Secure Assessment Browser Setup"
        Width="820" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    
    <!-- Outer Card Container with Border and Drop Shadow -->
    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" Opacity="0.45" ShadowDepth="8" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Main Content (Rail + Screens) -->
                <RowDefinition Height="64" />  <!-- Navigation Actions Footer -->
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- 1. CUSTOM TITLE BAR (Draggable)                             -->
            <!-- ============================================================ -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/AppIcon.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Klyro Setup" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="v1.0.0 (x64)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnMinimize" Content="—" Width="32" Height="28" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click" Margin="0,0,4,0" FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E293B" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnClose" Content="✕" Width="32" Height="28" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click" FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC2626" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- 2. MAIN BODY (Sidebar Rail + Wizard Screens)                -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />  <!-- Left Navigation Rail -->
                    <ColumnDefinition Width="*" />    <!-- Right Screen Pages -->
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR RAIL -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="18,24,18,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Product Logo & Branding Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,28">
                            <Border Width="48" Height="48" CornerRadius="10" Background="#111827" BorderBrush="#1E293B" BorderThickness="1"
                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                <Image Source="Assets/AppIcon.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="KLYRO" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2" />
                            <TextBlock Text="Secure Assessment Browser" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Wizard Steps Rail Indicator -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <!-- Step 1 Indicator -->
                            <Grid x:Name="stepPill1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="stepBadge1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentPrimaryBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="stepBadgeText1" Text="1" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock x:Name="stepTitle1" Text="License Agreement" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Terms &amp; Conditions" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Step 2 Indicator -->
                            <Grid x:Name="stepPill2" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="stepBadge2" Width="24" Height="24" CornerRadius="12" Background="#1E293B"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="stepBadgeText2" Text="2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock x:Name="stepTitle2" Text="Options &amp; Shortcuts" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Destination &amp; Placement" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Step 3 Indicator -->
                            <Grid x:Name="stepPill3" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="stepBadge3" Width="24" Height="24" CornerRadius="12" Background="#1E293B"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="stepBadgeText3" Text="3" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock x:Name="stepTitle3" Text="Installation" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Deploy Binaries" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Step 4 Indicator -->
                            <Grid x:Name="stepPill4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="stepBadge4" Width="24" Height="24" CornerRadius="12" Background="#1E293B"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="stepBadgeText4" Text="4" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock x:Name="stepTitle4" Text="Completion" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Setup Finished" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Sidebar Footer -->
                        <Border Grid.Row="2" Background="#0E1626" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="LOCKDOWN SYSTEM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGlowBrush}" />
                                <TextBlock Text="Dual-WebView State Isolation" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT CONTENT PAGES -->
                <Grid Grid.Column="1" Margin="24,20,24,10">
                    <!-- ============================================================ -->
                    <!-- SCREEN 1: TERMS AND CONDITIONS (EULA)                        -->
                    <!-- ============================================================ -->
                    <Grid x:Name="gridScreen1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="STEP 1 OF 4" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGlowBrush}" />
                            </Border>
                            <TextBlock Text="License Agreement &amp; Terms of Use" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Please review the license terms and assessment policies before continuing."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Scrollable Terms & Conditions Box -->
                        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="txtTermsContent"
                                           FontFamily="Consolas, Cascadia Code, Segoe UI, sans-serif"
                                           FontSize="11.5"
                                           LineHeight="18"
                                           Foreground="#CBD5E1"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <!-- Radial / Radio Buttons for Acceptance -->
                        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <RadioButton x:Name="rbAcceptTerms"
                                             GroupName="LicenseAcceptance"
                                             Style="{StaticResource InstallerRadioButtonStyle}"
                                             Checked="RbTerms_CheckedChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="I accept the terms in the License Agreement" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="rbDeclineTerms"
                                             GroupName="LicenseAcceptance"
                                             IsChecked="True"
                                             Style="{StaticResource InstallerRadioButtonStyle}"
                                             Checked="RbTerms_CheckedChanged" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="I do not accept the terms in the License Agreement" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================================ -->
                    <!-- SCREEN 2: INSTALLATION OPTIONS & SHORTCUTS (RADIAL BUTTONS)  -->
                    <!-- ============================================================ -->
                    <Grid x:Name="gridScreen2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="STEP 2 OF 4" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGlowBrush}" />
                            </Border>
                            <TextBlock Text="Installation Options &amp; Shortcuts" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Configure destination directory and choose your shortcut placement preferences."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Administrator Privilege Status Banner -->
                                <Border x:Name="bannerAdminActive" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🛡️" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="Administrator Privileges: Verified" FontSize="12.5" FontWeight="Bold" Foreground="#10B981" />
                                            <TextBlock Text="Setup is running elevated. System-wide installation and machine security policies are enabled."
                                                       FontSize="11" Foreground="#A7F3D0" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="bannerAdminRequired" Background="#261C0E" BorderBrush="#D97706" BorderThickness="1"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Visible">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                            <TextBlock Text="Standard User Mode (Non-Elevated)" FontSize="12.5" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Text="System installation to C:\Klyro requires Administrator rights. Elevate or choose current user."
                                                       FontSize="11" Foreground="#FDE68A" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Name="btnElevate" Content="🛡️ Elevate (UAC)" Height="32" Padding="10,0"
                                                Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5"
                                                BorderThickness="0" Cursor="Hand" Click="BtnElevate_Click" VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1D4ED8" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Installation Scope Section -->
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Installation Scope" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                        <TextBlock Text="Choose how Klyro will be installed on this computer:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                        <Border Background="#0D1526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <RadioButton x:Name="rbScopeAllUsers" GroupName="InstallScope" IsChecked="True" Style="{StaticResource InstallerRadioButtonStyle}" Checked="RbScope_CheckedChanged">
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Install for all users on this machine (System-wide, requires Administrator)" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Installs to C:\Klyro and configures campus exam access across all local Windows accounts." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>

                                        <Border Background="#0D1526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <RadioButton x:Name="rbScopeCurrentUser" GroupName="InstallScope" Style="{StaticResource InstallerRadioButtonStyle}" Checked="RbScope_CheckedChanged">
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Install for current user only (No Administrator required)" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Installs to your personal AppData folder without prompting for administrative permissions." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Destination Folder Section -->
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Destination Folder" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#0B0F19" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Height="36">
                                                <TextBox x:Name="txtInstallDir" Text="C:\Klyro" VerticalContentAlignment="Center"
                                                         Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                         FontSize="12.5" Padding="10,0" />
                                            </Border>
                                            <Button Grid.Column="1" x:Name="btnBrowse" Content="Browse..." Width="90" Height="36"
                                                    Margin="10,0,0,0" Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0"
                                                    Cursor="Hand" Click="BtnBrowse_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Space required: 350 MB" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="txtDriveSpace" Text="Space available: Calculating..." FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Create Shortcut Radial Buttons Section -->
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Shortcut Creation Preferences" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                        <TextBlock Text="Select where setup should create shortcuts for launching Klyro:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                        <!-- Radial Button 1: Both (Recommended) -->
                                        <Border Background="#0D1526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <RadioButton x:Name="rbShortcutBoth" GroupName="ShortcutOptions" IsChecked="True" Style="{StaticResource InstallerRadioButtonStyle}">
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Create Desktop and Start Menu shortcuts (Recommended)" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Places a quick-launch icon on your Desktop and indexes Klyro in Start Menu search." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>

                                        <!-- Radial Button 2: Desktop Only -->
                                        <Border Background="#0D1526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <RadioButton x:Name="rbShortcutDesktop" GroupName="ShortcutOptions" Style="{StaticResource InstallerRadioButtonStyle}">
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Create Desktop shortcut only" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Places a quick-launch icon on your Desktop only." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>

                                        <!-- Radial Button 3: Start Menu Only -->
                                        <Border Background="#0D1526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <RadioButton x:Name="rbShortcutStartMenu" GroupName="ShortcutOptions" Style="{StaticResource InstallerRadioButtonStyle}">
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Create Start Menu shortcut only" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Adds Klyro to your Windows Start Menu without placing an icon on your desktop." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>

                                        <!-- Radial Button 4: None -->
                                        <Border Background="#0D1526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <RadioButton x:Name="rbShortcutNone" GroupName="ShortcutOptions" Style="{StaticResource InstallerRadioButtonStyle}">
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Do not create shortcuts" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="Installs the application files without creating any desktop or start menu shortcuts." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Additional Security Options -->
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <StackPanel>
                                        <CheckBox x:Name="chkUnblockFiles" Content="Remove Windows Mark-of-the-Web zone flags (Unblock files)"
                                                  IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,6" Cursor="Hand" />
                                        <CheckBox x:Name="chkGrantPermissions" Content="Grant full read/write security permissions to standard Windows users"
                                                  IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Cursor="Hand" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================================ -->
                    <!-- SCREEN 3: READY TO INSTALL / ACTIVE INSTALLATION            -->
                    <!-- ============================================================ -->
                    <Grid x:Name="gridScreen3" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="STEP 3 OF 4" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGlowBrush}" />
                            </Border>
                            <TextBlock x:Name="txtScreen3Title" Text="Ready to Install" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock x:Name="txtScreen3Subtitle" Text="Click Install to begin deploying Klyro Secure Assessment Browser on your computer."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Sub-State A: Pre-Installation Summary (Before user clicks Install) -->
                        <Grid x:Name="panelPreInstallSummary" Grid.Row="1" Visibility="Visible">
                            <StackPanel>
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Installation Configuration Summary" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Installation Scope:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock x:Name="lblSummaryScope" Text="System-Wide (All Users)" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Privilege Level:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock x:Name="lblSummaryAdmin" Text="Administrator" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Target Location:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock x:Name="lblSummaryTarget" Text="C:\Klyro" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Shortcuts Selected:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock x:Name="lblSummaryShortcuts" Text="Desktop and Start Menu" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="MOTW Unblocking:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="Enabled" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Architecture:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="Win-x64 Self-Contained (.NET 8 LTS)" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0D1526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#1E293B" Margin="0,0,14,0">
                                            <TextBlock Text="ℹ" FontSize="16" Foreground="{StaticResource AccentGlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Click Install to continue" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="Or click Back if you want to review or change any settings." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Sub-State B: Active Installation Progress (While installing) -->
                        <Grid x:Name="panelInstallProgress" Grid.Row="1" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" Margin="10,0">
                                <!-- Progress Percentage and Status Header -->
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="txtCurrentStatus" Text="Extracting application files..." FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="txtPercent" Text="0%" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGlowBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Modern Smooth Progress Bar -->
                                <Border Height="12" Background="#111827" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,20">
                                    <ProgressBar x:Name="installProgressBar" Height="10" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="{StaticResource AccentPrimaryBrush}" Background="Transparent" BorderThickness="0" />
                                </Border>

                                <!-- Live Log Card -->
                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,10" Height="180">
                                    <ScrollViewer x:Name="scrollLog" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="txtLiveLog" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11"
                                                   Foreground="#94A3B8" LineHeight="16" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ============================================================ -->
                    <!-- SCREEN 4: INSTALLATION COMPLETED                            -->
                    <!-- ============================================================ -->
                    <Grid x:Name="gridScreen4" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                            <!-- Hero Checkmark Badge -->
                            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource SuccessGreenBgBrush}"
                                    BorderBrush="{StaticResource SuccessGreenBrush}" BorderThickness="2"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="✓" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                            </Border>

                            <TextBlock Text="Installation Complete!" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Klyro Secure Assessment Browser has been successfully installed on your computer."
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,24" />

                            <!-- Details Card -->
                            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Installation Mode:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="lblFinishedScope" Text="System-Wide (All Users)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Executable Path:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="lblFinishedExePath" Text="C:\Klyro\Klyro.App.exe" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Shortcuts Created:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="lblFinishedShortcuts" Text="Desktop &amp; Start Menu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Security Environment:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Configured &amp; Verified" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Launch Checkbox -->
                            <Border Background="#0D1526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                <CheckBox x:Name="chkLaunchApp" IsChecked="True" Cursor="Hand" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <TextBlock Text="Launch Klyro Secure Assessment Browser now" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============================================================ -->
            <!-- 3. NAVIGATION CONTROLS FOOTER                                -->
            <!-- ============================================================ -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBackgroundBrush}"
                    CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Action: Cancel Button -->
                    <Button x:Name="btnCancel" Grid.Column="0" Content="Cancel" Width="90" Height="36"
                            Background="#1E293B" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0"
                            Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#334155" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Right Actions Stack -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Back Button -->
                        <Button x:Name="btnBack" Content="&lt; Back" Width="90" Height="36" Margin="0,0,10,0"
                                Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Visibility="Collapsed"
                                Cursor="Hand" Click="BtnBack_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#334155" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Next Button (Screen 1 & 2) -->
                        <Button x:Name="btnNext" Content="Next &gt;" Width="105" Height="36"
                                Background="{StaticResource AccentPrimaryBrush}" Foreground="#FFFFFF" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="BtnNext_Click" IsEnabled="False">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#1E293B" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter Property="Cursor" Value="No" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Install Button (Screen 3) -->
                        <Button x:Name="btnInstall" Content="Install" Width="115" Height="36" Visibility="Collapsed"
                                Background="{StaticResource AccentPrimaryBrush}" Foreground="#FFFFFF" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="BtnInstall_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Finish Button (Screen 4) -->
                        <Button x:Name="btnFinish" Content="Finish" Width="105" Height="36" Visibility="Collapsed"
                                Background="{StaticResource SuccessGreenBrush}" Foreground="#FFFFFF" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="BtnFinish_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#059669" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
