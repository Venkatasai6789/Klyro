<Application x:Class="Klyro.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Modern Colors -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F19" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#080C14" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentGlowBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="SuccessGreenBgBrush" Color="#064E3B" />

        <!-- Control Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="InstallerRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Application.Resources>
</Application>
