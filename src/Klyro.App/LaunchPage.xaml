<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Klyro_App.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Klyro_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="GetStartedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0066FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoogleSignInButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="KlyroTextGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#5DCBFA" Offset="0.0" />
            <GradientStop Color="#40A8FD" Offset="0.45" />
            <GradientStop Color="#1075FE" Offset="0.85" />
            <GradientStop Color="#116FF9" Offset="1.0" />
        </LinearGradientBrush>
    </Page.Resources>

    <!-- Root 50/50 Split Container matching 1536 x 1024 reference layout -->
    <Grid x:Name="RootGrid" Background="#0F1219">
        <Grid.ColumnDefinitions>
            <!-- Left Branding Panel (exact 50% width) -->
            <ColumnDefinition Width="1*" />
            <!-- Right Content & Status Panel (exact 50% width) -->
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Background Artwork Screen 1 & 2 (Full Window 1.5 aspect ratio, preserving circular spiral geometry) -->
        <Image x:Name="StartupScreenBg"
               Source="ms-appx:///Assets/StartUp_Screen_Bg.png"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Opacity="1"
               IsHitTestVisible="False" />

        <!-- Background Artwork Screen 3: Google Sign-in illustration (exact 50% left panel) -->
        <Image x:Name="GoogleSigninBg"
               Source="ms-appx:///Assets/Google_Signin_Screen.png"
               Grid.Column="0"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Opacity="0"
               IsHitTestVisible="False" />

        <!-- Background Artwork Screen 5 & 6: Environment Preflight illustration (Full Window 1.5 aspect ratio, left 50% visible) -->
        <Image x:Name="PreflightScreenBg"
               Source="ms-appx:///Assets/Test_Screen_Bg.png"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Opacity="0"
               IsHitTestVisible="False" />

        <!-- ============================================================ -->
        <!-- LEFT PANEL: Visual Artwork & Centered Klyro Logo             -->
        <!-- ============================================================ -->
        <Grid Grid.Column="0"
              Background="Transparent"
              PointerPressed="TitleBar_PointerPressed">

            <!-- Official Klyro Logo (295 x 295 DIPs = 442 physical px, shifted upward into the visual eye of the spiral) -->
            <Image x:Name="KlyroBrandLogo"
                   Source="ms-appx:///Assets/Klyro_Logo.png"
                   Width="295"
                   Height="295"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="8,-53,0,0"
                   Opacity="1"
                   IsHitTestVisible="False" />
        </Grid>

        <!-- ============================================================ -->
        <!-- RIGHT PANEL: Window Controls, Brand Info, Progress & Features-->
        <!-- ============================================================ -->
        <Grid Grid.Column="1" Background="#0F1219">
            <Grid.RowDefinitions>
                <!-- Top Title / Window Control Bar (44px) -->
                <RowDefinition Height="Auto" />
                <!-- Main Content Area -->
                <RowDefinition Height="*" />
                <!-- Feature Highlights Footer Area -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top Drag Bar and Native-style Window Controls in Top-Right Corner -->
            <Grid Grid.Row="0"
                  Height="44"
                  Background="Transparent"
                  PointerPressed="TitleBar_PointerPressed">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                <!-- Minimize Button -->
                <Button x:Name="MinimizeButton"
                        Click="Minimize_Click"
                        AutomationProperties.Name="Minimize"
                        ToolTipService.ToolTip="Minimize"
                        Width="44" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        IsTabStop="False">
                    <FontIcon Glyph="&#xE921;" FontSize="11" Foreground="#94A3B8" />
                </Button>

                <!-- Maximize / Restore Button -->
                <Button x:Name="MaximizeButton"
                        Click="Maximize_Click"
                        AutomationProperties.Name="Maximize"
                        ToolTipService.ToolTip="Maximize"
                        Width="44" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        IsTabStop="False">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontSize="11" Foreground="#94A3B8" />
                </Button>

                <!-- Close Button -->
                <Button x:Name="CloseButton"
                        Click="Close_Click"
                        AutomationProperties.Name="Close"
                        ToolTipService.ToolTip="Close"
                        Width="44" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        IsTabStop="False"
                        PointerEntered="CloseButton_PointerEntered"
                        PointerExited="CloseButton_PointerExited">
                    <FontIcon x:Name="CloseIcon" Glyph="&#xE8BB;" FontSize="11" Foreground="#94A3B8" />
                </Button>
            </StackPanel>
            </Grid>

            <!-- Content Container holding both Onboarding States (Startup & Welcome) -->
            <Grid Grid.Row="1" Grid.RowSpan="2">

                <!-- ============================================================ -->
                <!-- STATE 1: STARTUP / INITIALIZATION (Screen 01)                -->
                <!-- ============================================================ -->
                <Grid x:Name="StartupStateGrid" Visibility="Visible" Opacity="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Main Content Stack (Title, Subtitle, Description, Progress, Status) -->
                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="48,0,0,0"
                                MaxWidth="380">

                        <!-- Brand Title: "Klyro" -->
                        <TextBlock Text="Klyro"
                                   FontSize="52"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource KlyroTextGradientBrush}"
                                   HorizontalAlignment="Left"
                                   CharacterSpacing="10"
                                   Margin="0,0,0,4" />

                        <!-- Product Subtitle: "Secure Assessment Browser" -->
                        <TextBlock Text="Secure Assessment Browser"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#CBD5E1"
                                   Margin="0,0,0,20" />

                        <!-- Description (Two lines on desktop) -->
                        <TextBlock FontSize="15"
                                   LineHeight="24"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,0,0,30">
                            <Run Text="A safe and controlled browsing environment" /><LineBreak />
                            <Run Text="for fair and secure assessments." />
                        </TextBlock>

                        <!-- Startup Horizontal Progress Bar Track (380 x 14 px) -->
                        <Grid Width="380"
                              Height="14"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,14">
                            <!-- Dark Gray Track -->
                            <Border Background="#1E2638" CornerRadius="7" />

                            <!-- Blue Progress Fill Bar -->
                            <Border x:Name="ProgressBarFill"
                                    Width="0"
                                    Height="14"
                                    Background="#0066FF"
                                    CornerRadius="7"
                                    HorizontalAlignment="Left" />
                        </Grid>

                        <!-- Dynamic Status Text -->
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Starting Klyro..."
                                   FontSize="14"
                                   FontWeight="Normal"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,0" />

                        <!-- Startup Error Card (Displayed only when initialization fails) -->
                        <Border x:Name="StartupErrorCard"
                                Background="#1C1418"
                                BorderBrush="#7F1D1D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,18,0,0"
                                MaxWidth="380"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEB55;" FontSize="16" Foreground="#EF4444" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StartupErrorMessage"
                                               Text="Startup check failed."
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FCA5A5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="RetryButton"
                                            Content="Retry Startup"
                                            Click="Retry_Click"
                                            Background="#2563EB"
                                            Foreground="#FFFFFF"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Padding="16,6"
                                            CornerRadius="6" />
                                    <Button Content="Exit"
                                            Click="Close_Click"
                                            Background="#1E293B"
                                            Foreground="#CBD5E1"
                                            FontSize="12"
                                            Padding="16,6"
                                            CornerRadius="6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Feature Indicators Row (Bottom of Right Panel) -->
                    <Grid Grid.Row="1"
                          Width="380"
                          HorizontalAlignment="Left"
                          Margin="48,0,0,48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="125" />
                        </Grid.ColumnDefinitions>

                        <!-- FEATURE 1: Secure Environment -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#131B2E" BorderBrush="#1E2C48" BorderThickness="1" HorizontalAlignment="Center">
                                <Image Source="ms-appx:///Assets/Secure_Environment.png" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="#94A3B8" TextAlignment="Center" LineHeight="16" Margin="0,8,0,0">
                                <Run Text="Secure" /><LineBreak /><Run Text="Environment" />
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Height="48" Background="#1E293B" VerticalAlignment="Center" />

                        <!-- FEATURE 2: Distraction Free -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#131B2E" BorderBrush="#1E2C48" BorderThickness="1" HorizontalAlignment="Center">
                                <Image Source="ms-appx:///Assets/distraction_free.png" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="#94A3B8" TextAlignment="Center" LineHeight="16" Margin="0,8,0,0">
                                <Run Text="Distraction" /><LineBreak /><Run Text="Free" />
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Height="48" Background="#1E293B" VerticalAlignment="Center" />

                        <!-- FEATURE 3: Trusted by Institutions -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#131B2E" BorderBrush="#1E2C48" BorderThickness="1" HorizontalAlignment="Center">
                                <Image Source="ms-appx:///Assets/Trusted_Instructions.png" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="#94A3B8" TextAlignment="Center" LineHeight="16" Margin="0,8,0,0">
                                <Run Text="Trusted by" /><LineBreak /><Run Text="Institutions" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============================================================ -->
                <!-- STATE 2: WELCOME TO KLYRO (Screen 02)                        -->
                <!-- ============================================================ -->
                <Grid x:Name="WelcomeStateGrid" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="48,0,0,0"
                                MaxWidth="380">

                        <!-- 1. Header Sub-badge: Horizontal Blue Accent Bar + WELCOME -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,0,0,24">
                            <Border Width="36"
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="#0066FF"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="WELCOME"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="200"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 2. Main Heading: "Welcome to \n Klyro" -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Welcome to"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       LineHeight="46" />
                            <TextBlock Text="Klyro"
                                       FontSize="50"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource KlyroTextGradientBrush}"
                                       HorizontalAlignment="Left"
                                       LineHeight="52" />
                        </StackPanel>

                        <!-- 3. Subtitle / Description -->
                        <TextBlock FontSize="15"
                                   LineHeight="24"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,0,0,32">
                            <Run Text="Your secure environment for university" /><LineBreak />
                            <Run Text="assessments." />
                        </TextBlock>

                        <!-- 4. Feature Indicators Row (With subtle hover micro-interactions) -->
                        <Grid Width="380"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="125" />
                            </Grid.ColumnDefinitions>

                            <!-- FEATURE 1: Secure Environment -->
                            <StackPanel x:Name="WCard1"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        PointerEntered="FeatureCard_PointerEntered"
                                        PointerExited="FeatureCard_PointerExited">
                                <Border x:Name="WIconBorder1"
                                        Width="44" Height="44"
                                        CornerRadius="10"
                                        Background="#131B2E"
                                        BorderBrush="#1E2C48"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/Secure_Environment.png"
                                           Width="26" Height="26"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="WText1"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#94A3B8"
                                           TextAlignment="Center"
                                           LineHeight="16"
                                           Margin="0,8,0,0">
                                    <Run Text="Secure" /><LineBreak /><Run Text="Environment" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Height="48" Background="#1E293B" VerticalAlignment="Center" />

                            <!-- FEATURE 2: Distraction Free -->
                            <StackPanel x:Name="WCard2"
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        PointerEntered="FeatureCard_PointerEntered"
                                        PointerExited="FeatureCard_PointerExited">
                                <Border x:Name="WIconBorder2"
                                        Width="44" Height="44"
                                        CornerRadius="10"
                                        Background="#131B2E"
                                        BorderBrush="#1E2C48"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/distraction_free.png"
                                           Width="26" Height="26"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="WText2"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#94A3B8"
                                           TextAlignment="Center"
                                           LineHeight="16"
                                           Margin="0,8,0,0">
                                    <Run Text="Distraction" /><LineBreak /><Run Text="Free" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="3" Width="1" Height="48" Background="#1E293B" VerticalAlignment="Center" />

                            <!-- FEATURE 3: Trusted by Institutions -->
                            <StackPanel x:Name="WCard3"
                                        Grid.Column="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        PointerEntered="FeatureCard_PointerEntered"
                                        PointerExited="FeatureCard_PointerExited">
                                <Border x:Name="WIconBorder3"
                                        Width="44" Height="44"
                                        CornerRadius="10"
                                        Background="#131B2E"
                                        BorderBrush="#1E2C48"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/Trusted_Instructions.png"
                                           Width="26" Height="26"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="WText3"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#94A3B8"
                                           TextAlignment="Center"
                                           LineHeight="16"
                                           Margin="0,8,0,0">
                                    <Run Text="Trusted by" /><LineBreak /><Run Text="Institutions" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- 5. Get Started Primary Action Button (Screen 1 Consistent: 380 DIP width, 8px radius, Royal Blue) -->
                        <Button x:Name="GetStartedButton"
                                Style="{StaticResource GetStartedButtonStyle}"
                                Click="GetStarted_Click"
                                PointerEntered="GetStarted_PointerEntered"
                                PointerExited="GetStarted_PointerExited"
                                PointerPressed="GetStarted_PointerPressed"
                                PointerReleased="GetStarted_PointerReleased"
                                Width="380"
                                Height="48"
                                Padding="20,0"
                                Background="#0066FF"
                                BorderThickness="1"
                                BorderBrush="#2563EB"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Get Started"
                                ToolTipService.ToolTip="Continue to university assessment"
                                TabIndex="0">
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock Text="Get Started"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />

                                <Border x:Name="ArrowBadge"
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="#1A75FF"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <FontIcon x:Name="ArrowIcon"
                                              Glyph="&#xE72A;"
                                              FontSize="13"
                                              Foreground="#FFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 6. Helper Text: First-time users only. -->
                        <TextBlock Text="First-time users only."
                                   FontSize="13"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Left"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- STATE 3: GOOGLE ACCOUNT SETUP (Screen 03)                    -->
                <!-- ============================================================ -->
                <Grid x:Name="AccountSetupStateGrid" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="48,-78,0,0"
                                MaxWidth="380">

                        <!-- 1. Header Sub-badge: Horizontal Blue Accent Bar + ACCOUNT SETUP -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,0,0,24">
                            <Border Width="36"
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="#0066FF"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="ACCOUNT SETUP"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="200"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 2. Main Heading: "Connect \n your account" -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Connect"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       LineHeight="46" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="your"
                                           FontSize="44"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           LineHeight="46"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="account"
                                           FontSize="44"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource KlyroTextGradientBrush}"
                                           LineHeight="46" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. Subtitle / Description -->
                        <TextBlock FontSize="15"
                                   LineHeight="24"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,0,0,32">
                            <Run Text="Sign in with your university" /><LineBreak />
                            <Run Text="Google account." />
                        </TextBlock>

                        <!-- 4. Google Primary Action Button -->
                        <Button x:Name="GoogleSignInButton"
                                Style="{StaticResource GoogleSignInButtonStyle}"
                                Click="GoogleSignIn_Click"
                                PointerEntered="GoogleSignIn_PointerEntered"
                                PointerExited="GoogleSignIn_PointerExited"
                                PointerPressed="GoogleSignIn_PointerPressed"
                                PointerReleased="GoogleSignIn_PointerReleased"
                                Width="380"
                                Height="48"
                                Padding="16,0"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Continue with Google"
                                ToolTipService.ToolTip="Sign in with your Google account"
                                TabIndex="0">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Official Google 'G' Vector Icon (20x20) -->
                                <Viewbox Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#4285F4" Data="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.5 3.7l3.7 2.9c2.2-2 3.5-5 3.5-8.9z" />
                                        <Path Fill="#34A853" Data="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 16C3.7 19.7 7.5 23 12 23z" />
                                        <Path Fill="#FBBC05" Data="M5.6 13.1c-.2-.7-.3-1.4-.3-2.1s.1-1.4.3-2.1L1.9 6C1.3 7.4 1 8.9 1 10.5s.3 3.1.9 4.5l3.7-2.9z" />
                                        <Path Fill="#EA4335" Data="M12 4.8c1.7 0 3.1.6 4.3 1.7l3.2-3.2C17.5 1.5 14.9.8 12 .8 7.5.8 3.7 3.5 1.9 7.2l3.7 2.9c.9-2.8 3.4-4.8 6.4-4.8z" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Button Label -->
                                <TextBlock x:Name="GoogleButtonText"
                                           Grid.Column="1"
                                           Text="Continue with Google"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />

                                <!-- Right Arrow Glyph (Blue) with smooth glide on hover -->
                                <FontIcon x:Name="GoogleArrowIcon"
                                          Grid.Column="2"
                                          Glyph="&#xE72A;"
                                          FontSize="14"
                                          Foreground="#0066FF"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" />

                                <!-- Loading Progress Ring -->
                                <ProgressRing x:Name="GoogleAuthProgressRing"
                                              Grid.Column="2"
                                              Width="18"
                                              Height="18"
                                              Foreground="#0066FF"
                                              IsActive="False"
                                              Visibility="Collapsed"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <!-- Modern Subtle Divider: OR -->
                        <Grid Width="380" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="#1E2638" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="OR" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="14,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="#1E2638" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 4.1 System Browser Action Button (RFC 8252 Industry Best Practice) -->
                        <Button x:Name="SystemBrowserSignInButton"
                                Click="SystemBrowserSignIn_Click"
                                PointerEntered="SystemBrowserSignIn_PointerEntered"
                                PointerExited="SystemBrowserSignIn_PointerExited"
                                Width="380"
                                Height="48"
                                Padding="16,0"
                                Background="#131B2E"
                                BorderBrush="#253554"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Sign in with Default Browser"
                                ToolTipService.ToolTip="Launch external browser (Edge/Chrome) for Google authentication"
                                TabIndex="1">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#0C1F38" BorderBrush="#1E3A5F" BorderThickness="1">
                                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Sign in with Default Browser" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#0C1F38" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Recommended" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    </Border>
                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- System Browser In-Progress Waiting Card with IDE-like Live Detection -->
                        <Border x:Name="BrowserAuthWaitingCard"
                                Background="#131B2E"
                                BorderBrush="#253554"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,16,0,0"
                                MaxWidth="380"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ProgressRing x:Name="BrowserAuthSpinner" IsActive="True" Width="20" Height="20" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BrowserAuthHeaderTitle" Text="Waiting for Browser Sign-in..." FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Live Status Badge -->
                                <Border Background="#0C1F38" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" Fill="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BrowserAuthStatusPillText" Text="Listening for callback &amp; window return..." FontSize="11" FontWeight="Medium" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="BrowserAuthDescText"
                                           Text="Sign in in your browser. Klyro will automatically detect your login as soon as you switch back."
                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BrowserAuthVerifyBtn"
                                            Content="I've Signed In (Continue)"
                                            Click="VerifyBrowserAuth_Click"
                                            Background="#0066FF"
                                            Foreground="#FFFFFF"
                                            FontSize="12" FontWeight="SemiBold"
                                            Height="34"
                                            Padding="14,0" CornerRadius="6" />
                                    <Button Content="Cancel"
                                            Click="CancelBrowserAuth_Click"
                                            Background="#1E293B"
                                            Foreground="#CBD5E1"
                                            FontSize="12" FontWeight="Medium"
                                            Height="34"
                                            Padding="14,0" CornerRadius="6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Connection Assistance / Fallback Card (User-friendly diagnosis without error codes) -->
                        <Border x:Name="GoogleAuthErrorCard"
                                Background="#141B2D"
                                BorderBrush="#253554"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,18,0,0"
                                MaxWidth="380"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE701;" FontSize="15" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GoogleAuthErrorTitle"
                                               Text="Connection Assistance"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF" />
                                </StackPanel>
                                <TextBlock x:Name="GoogleAuthErrorMessage"
                                           Text="Unable to reach Google's authentication servers. You can retry, access the campus Wi-Fi portal, or use offline invigilator authorization."
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           LineHeight="18" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Try Again"
                                            Click="RetryGoogleAuth_Click"
                                            Background="#0066FF"
                                            Foreground="#FFFFFF"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Padding="12,6"
                                            CornerRadius="6" />
                                    <Button Content="Use Browser"
                                            Click="SystemBrowserSignIn_Click"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Padding="10,6"
                                            CornerRadius="6" />
                                    <Button Content="Campus Portal"
                                            Click="OpenCampusPortalFromCard_Click"
                                            Background="#1E293B"
                                            Foreground="#CBD5E1"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Padding="10,6"
                                            CornerRadius="6" />
                                    <Button Content="Offline Bypass"
                                            Click="OpenInvigilatorBypass_Click"
                                            Background="Transparent"
                                            Foreground="#60A5FA"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Padding="6,6"
                                            CornerRadius="6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- STATE 4: GOOGLE ACCOUNT CONNECTED (Screen 04)                -->
                <!-- ============================================================ -->
                <Grid x:Name="AccountConnectedStateGrid" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="420"
                                Margin="0,-16,0,0">

                        <!-- 1. Header Sub-badge: Horizontal Blue Accent Bar + ACCOUNT SETUP -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,0,0,24">
                            <Border Width="36"
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="#0066FF"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="ACCOUNT SETUP"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="200"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 2. Main Heading: "You’re signed in" -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,28">
                            <TextBlock Text="You’re"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="signed in"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource KlyroTextGradientBrush}" />
                        </StackPanel>

                        <!-- 3. Profile Avatar with Google Badge + Name + Email -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                            <!-- Circular Avatar Container (96x96 DIPs) -->
                            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                                <!-- Circular Border with subtle blue accent -->
                                <Border Width="96" Height="96"
                                        CornerRadius="48"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        Background="#162238">
                                    <Grid>
                                        <!-- Deterministic Initials Fallback -->
                                        <TextBlock x:Name="ConnectedUserInitials"
                                                   Text=""
                                                   FontSize="32"
                                                   FontWeight="Bold"
                                                   Foreground="#38BDF8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                        <!-- Circular Profile Photo -->
                                        <Border x:Name="ConnectedUserPhotoBorder" Width="92" Height="92" CornerRadius="46" Visibility="Collapsed">
                                            <Border.Background>
                                                <ImageBrush x:Name="ConnectedUserPhotoBrush" Stretch="UniformToFill" ImageOpened="ConnectedUserPhoto_ImageOpened" ImageFailed="ConnectedUserPhoto_ImageFailed" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Official Google 'G' Vector Badge (28x28 DIPs) overlapping lower-right -->
                                <Border Width="28" Height="28"
                                        CornerRadius="14"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-2,-2">
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#4285F4" Data="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.5 3.7l3.7 2.9c2.2-2 3.5-5 3.5-8.9z" />
                                            <Path Fill="#34A853" Data="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 16C3.7 19.7 7.5 23 12 23z" />
                                            <Path Fill="#FBBC05" Data="M5.6 13.1c-.2-.7-.3-1.4-.3-2.1s.1-1.4.3-2.1L1.9 6C1.3 7.4 1 8.9 1 10.5s.3 3.1.9 4.5l3.7-2.9z" />
                                            <Path Fill="#EA4335" Data="M12 4.8c1.7 0 3.1.6 4.3 1.7l3.2-3.2C17.5 1.5 14.9.8 12 .8 7.5.8 3.7 3.5 1.9 7.2l3.7 2.9c.9-2.8 3.4-4.8 6.4-4.8z" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Grid>

                            <!-- User Display Name -->
                            <TextBlock x:Name="ConnectedUserName"
                                       Text=""
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"
                                       Margin="0,14,0,0" />

                            <!-- User Email -->
                            <TextBlock x:Name="ConnectedUserEmail"
                                       Text=""
                                       FontSize="14"
                                       Foreground="#94A3B8"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="360"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 4. Security Confirmation Message -->
                        <TextBlock Text="Your university Google account is connected securely."
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,28" />

                        <!-- 5. Primary Action: Continue Button (Reuses Screen 2 styling) -->
                        <Button x:Name="ContinueButton"
                                Style="{StaticResource GetStartedButtonStyle}"
                                Click="ContinueButton_Click"
                                PointerEntered="ContinueButton_PointerEntered"
                                PointerExited="ContinueButton_PointerExited"
                                PointerPressed="ContinueButton_PointerPressed"
                                PointerReleased="ContinueButton_PointerReleased"
                                Width="380"
                                Height="48"
                                Padding="20,0"
                                Background="#0066FF"
                                BorderThickness="1"
                                BorderBrush="#2563EB"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Continue"
                                ToolTipService.ToolTip="Continue to examination"
                                TabIndex="0">
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock Text="Continue"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />

                                <Border x:Name="ContinueArrowBadge"
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="Transparent"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <FontIcon x:Name="ContinueArrowIcon"
                                              Glyph="&#xE72A;"
                                              FontSize="15"
                                              Foreground="#FFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 6. Secondary Action: Use a different account -->
                        <Button x:Name="UseDifferentAccountButton"
                                Click="UseDifferentAccount_Click"
                                PointerEntered="UseDifferentAccount_PointerEntered"
                                PointerExited="UseDifferentAccount_PointerExited"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                Foreground="#38BDF8"
                                FontSize="13"
                                FontWeight="Medium"
                                BorderThickness="0"
                                Margin="0,16,0,0"
                                Content="Use a different account" />
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- STATE 5: PREPARE YOUR ENVIRONMENT (Screen 05)                -->
                <!-- ============================================================ -->
                <Grid x:Name="PreflightPrepareStateGrid" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="48,24,0,0"
                                MaxWidth="440">

                        <!-- 1. Header Sub-badge: Horizontal Blue Accent Bar + ENVIRONMENT PREFLIGHT -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,0,0,22">
                            <Border Width="36"
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="#0066FF"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="ENVIRONMENT PREFLIGHT"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="200"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 2. Main Heading: "Prepare your \n environment" -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Prepare your"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       LineHeight="48" />
                            <TextBlock Text="environment"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource KlyroTextGradientBrush}"
                                       LineHeight="52" />
                        </StackPanel>

                        <!-- Candidate Identity Pill (for returning and newly-connected candidates) -->
                        <Border x:Name="PreflightCandidatePill"
                                Background="#141C2E"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="8,4,12,4"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#0066FF">
                                    <TextBlock x:Name="PreflightCandidateInitials"
                                               Text=""
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="PreflightCandidateName"
                                           Text=""
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="•" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreflightCandidateEmail"
                                           Text=""
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center" />
                                <Button x:Name="PreflightSwitchAccountButton"
                                        Content="Switch"
                                        Click="PreflightSwitchAccount_Click"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#38BDF8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Body Copy -->
                        <TextBlock Text="Klyro will check your account, network, internet connection and secure environment."
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   LineHeight="22"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="This usually takes less than a minute."
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,28" />

                        <!-- 4. Primary Action: Start Check Button -->
                        <Button x:Name="StartCheckButton"
                                Style="{StaticResource GetStartedButtonStyle}"
                                Click="StartCheckButton_Click"
                                PointerEntered="StartCheckButton_PointerEntered"
                                PointerExited="StartCheckButton_PointerExited"
                                PointerPressed="StartCheckButton_PointerPressed"
                                PointerReleased="StartCheckButton_PointerReleased"
                                Width="380"
                                Height="48"
                                Padding="20,0"
                                Background="#0066FF"
                                BorderThickness="1"
                                BorderBrush="#2563EB"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Start Check"
                                TabIndex="0"
                                Margin="0,0,0,40">
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock Text="Start Check"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />

                                <FontIcon x:Name="StartCheckArrowIcon"
                                          Glyph="&#xE72A;"
                                          FontSize="14"
                                          Foreground="#FFFFFF"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <!-- 5. Footer: 4 Capabilities Breakdown (Account, Network, Internet, Security) -->
                        <Grid Width="380" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Account Verification -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="8">
                                <Border Width="40" Height="40" CornerRadius="8" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock FontSize="11" FontWeight="Medium" Foreground="#94A3B8" TextAlignment="Center" LineHeight="15">
                                    <Run Text="Account" /><LineBreak /><Run Text="Verification" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Divider 1 -->
                            <Border Grid.Column="1" Background="#1E293B" Height="40" VerticalAlignment="Center" />

                            <!-- Column 2: Network Check -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="8">
                                <Border Width="40" Height="40" CornerRadius="8" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock FontSize="11" FontWeight="Medium" Foreground="#94A3B8" TextAlignment="Center" LineHeight="15">
                                    <Run Text="Network" /><LineBreak /><Run Text="Check" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Divider 2 -->
                            <Border Grid.Column="3" Background="#1E293B" Height="40" VerticalAlignment="Center" />

                            <!-- Column 3: Internet Connection -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="8">
                                <Border Width="40" Height="40" CornerRadius="8" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock FontSize="11" FontWeight="Medium" Foreground="#94A3B8" TextAlignment="Center" LineHeight="15">
                                    <Run Text="Internet" /><LineBreak /><Run Text="Connection" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Divider 3 -->
                            <Border Grid.Column="5" Background="#1E293B" Height="40" VerticalAlignment="Center" />

                            <!-- Column 4: Security Status -->
                            <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="8">
                                <Border Width="40" Height="40" CornerRadius="8" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock FontSize="11" FontWeight="Medium" Foreground="#94A3B8" TextAlignment="Center" LineHeight="15">
                                    <Run Text="Security" /><LineBreak /><Run Text="Status" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- STATE 6: CHECKING YOUR ENVIRONMENT (Screen 06)               -->
                <!-- ============================================================ -->
                <Grid x:Name="PreflightCheckingStateGrid" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="48,46,0,0"
                                MaxWidth="440">

                        <!-- 1. Header Sub-badge: Horizontal Blue Accent Bar + ENVIRONMENT CHECK -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,0,0,16">
                            <Border Width="36"
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="#0066FF"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="ENVIRONMENT CHECK"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="200"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 2. Main Heading: "Checking your \n environment" -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Checking your"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       LineHeight="48" />
                            <TextBlock Text="environment"
                                       FontSize="44"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource KlyroTextGradientBrush}"
                                       LineHeight="52" />
                        </StackPanel>

                        <!-- 3. Body Copy -->
                        <TextBlock Text="Klyro is verifying your setup. This usually takes less than a minute."
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,16" />

                        <!-- 4. Dynamic Check Rows Container (380 DIP width) -->
                        <StackPanel Spacing="7" Width="380" HorizontalAlignment="Left">

                            <!-- Row 1: Account -->
                            <Border x:Name="AccountCardBorder" Background="#141C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Icon Container -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border x:Name="AccountPassedIcon" Width="26" Height="26" CornerRadius="13" Background="#10B981" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ProgressRing x:Name="AccountProgressRing" Width="20" Height="20" Foreground="#38BDF8" IsActive="False" Visibility="Collapsed" />
                                        <Border x:Name="AccountWaitingIcon" Width="22" Height="22" CornerRadius="11" BorderBrush="#334155" BorderThickness="2" Background="Transparent" Visibility="Visible" />
                                        <Border x:Name="AccountFailedIcon" Width="26" Height="26" CornerRadius="13" Background="#EF4444" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Account" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="AccountSubtitleText" Text="Waiting for verification..." FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock x:Name="AccountStatusText" Grid.Column="2" Text="Waiting" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Row 2: Network -->
                            <Border x:Name="NetworkCardBorder" Background="#141C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border x:Name="NetworkPassedIcon" Width="26" Height="26" CornerRadius="13" Background="#10B981" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ProgressRing x:Name="NetworkProgressRing" Width="20" Height="20" Foreground="#38BDF8" IsActive="False" Visibility="Collapsed" />
                                        <Border x:Name="NetworkWaitingIcon" Width="22" Height="22" CornerRadius="11" BorderBrush="#334155" BorderThickness="2" Background="Transparent" Visibility="Visible" />
                                        <Border x:Name="NetworkFailedIcon" Width="26" Height="26" CornerRadius="13" Background="#EF4444" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Network" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="NetworkSubtitleText" Text="Waiting for network check..." FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock x:Name="NetworkStatusText" Grid.Column="2" Text="Waiting" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Row 3: Internet -->
                            <Border x:Name="InternetCardBorder" Background="#141C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border x:Name="InternetPassedIcon" Width="26" Height="26" CornerRadius="13" Background="#10B981" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ProgressRing x:Name="InternetProgressRing" Width="20" Height="20" Foreground="#38BDF8" IsActive="False" Visibility="Collapsed" />
                                        <Border x:Name="InternetWaitingIcon" Width="22" Height="22" CornerRadius="11" BorderBrush="#334155" BorderThickness="2" Background="Transparent" Visibility="Visible" />
                                        <Border x:Name="InternetFailedIcon" Width="26" Height="26" CornerRadius="13" Background="#EF4444" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Internet" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="InternetSubtitleText" Text="Waiting for connection..." FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock x:Name="InternetStatusText" Grid.Column="2" Text="Waiting" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Row 4: Assessment service -->
                            <Border x:Name="AssessmentCardBorder" Background="#141C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border x:Name="AssessmentPassedIcon" Width="26" Height="26" CornerRadius="13" Background="#10B981" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ProgressRing x:Name="AssessmentProgressRing" Width="20" Height="20" Foreground="#38BDF8" IsActive="False" Visibility="Collapsed" />
                                        <Border x:Name="AssessmentWaitingIcon" Width="22" Height="22" CornerRadius="11" BorderBrush="#334155" BorderThickness="2" Background="Transparent" Visibility="Visible" />
                                        <Border x:Name="AssessmentFailedIcon" Width="26" Height="26" CornerRadius="13" Background="#EF4444" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Assessment service" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="AssessmentSubtitleText" Text="Waiting for response..." FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock x:Name="AssessmentStatusText" Grid.Column="2" Text="Waiting" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Row 5: Secure environment -->
                            <Border x:Name="SecurityCardBorder" Background="#141C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border x:Name="SecurityPassedIcon" Width="26" Height="26" CornerRadius="13" Background="#10B981" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ProgressRing x:Name="SecurityProgressRing" Width="20" Height="20" Foreground="#38BDF8" IsActive="False" Visibility="Collapsed" />
                                        <Border x:Name="SecurityWaitingIcon" Width="22" Height="22" CornerRadius="11" BorderBrush="#334155" BorderThickness="2" Background="Transparent" Visibility="Visible" />
                                        <Border x:Name="SecurityFailedIcon" Width="26" Height="26" CornerRadius="13" Background="#EF4444" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Secure environment" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="SecuritySubtitleText" Text="Waiting for checks to complete..." FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock x:Name="SecurityStatusText" Grid.Column="2" Text="Waiting" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 5. Progress Indicator (Bar + Count) -->
                        <Grid Width="380" Margin="0,14,0,14" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="PreflightProgressBar" Grid.Column="0" Height="4" CornerRadius="2"
                                         Background="#1E293B" Foreground="#0066FF" Minimum="0" Maximum="5" Value="0"
                                         VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="PreflightProgressCounter" Grid.Column="1" Text="0 / 5"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 6. Advisory Info Box -->
                        <Border Width="380" Background="#101726" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,11" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="#38BDF8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" LineHeight="17" TextWrapping="Wrap">
                                    <Run Text="Please keep this window open during the checks." /><LineBreak />
                                    <Run Text="Do not disconnect from your network or close the application." />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- 7. Failure Remediation / Retry Container (shown only upon genuine failure) -->
                        <StackPanel x:Name="PreflightRetryContainer" Width="380" Visibility="Collapsed" Margin="0,12,0,0" Spacing="8">
                            <Border Background="#201115" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <TextBlock x:Name="PreflightErrorDetails" Text="" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" LineHeight="16" />
                            </Border>
                            <Button x:Name="PreflightRetryButton"
                                    Click="PreflightRetryButton_Click"
                                    Content="Retry Diagnostic Checks"
                                    Width="380"
                                    Height="40"
                                    Background="#2563EB"
                                    Foreground="#FFFFFF"
                                    CornerRadius="8"
                                    FontWeight="SemiBold"
                                    FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <Grid x:Name="GoogleAuthOverlay"
                      Background="#0F1219"
                      Visibility="Collapsed"
                      Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Overlay Header: Security padlock + Dynamic Title + Close Button -->
                    <Grid Grid.Row="0"
                          Background="#131B2E"
                          BorderBrush="#1E293B"
                          BorderThickness="0,0,0,1"
                          Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <FontIcon x:Name="OverlayHeaderIcon" Glyph="&#xE72E;" FontSize="13" Foreground="#22C55E" VerticalAlignment="Center" />
                            <TextBlock x:Name="OverlayHeaderTitle" Text="Sign in with Google" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock x:Name="OverlayHeaderSubtitle" Text="• accounts.google.com" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                            <Button Click="SystemBrowserSignIn_Click"
                                    Height="32"
                                    Padding="10,0"
                                    Background="#141B2D"
                                    BorderBrush="#253554"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="Switch to external browser (Chrome/Edge)">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <TextBlock Text="Open in Browser" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE8A7;" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center" Margin="2,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Click="CloseGoogleAuth_Click"
                                    Width="32" Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Cancel Google Sign-in">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#94A3B8" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Real WebView2 hosting Google Authentication in persistent Exam profile -->
                    <Grid Grid.Row="1">
                        <WebView2 x:Name="GoogleAuthWebView"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />

                        <!-- Loading Indicator while web content initializes -->
                        <StackPanel x:Name="GoogleWebViewLoading"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Visible">
                            <ProgressRing IsActive="True" Width="32" Height="32" Foreground="#0066FF" />
                            <TextBlock Text="Opening secure Google sign-in..."
                                       FontSize="13"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Dedicated In-App Fallback View (Shown instead of raw browser error codes) -->
                        <Grid x:Name="GoogleAuthFallbackOverlay"
                              Background="#0F1219"
                              Visibility="Collapsed"
                              Padding="32">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        MaxWidth="380"
                                        Spacing="16">

                                <!-- Alert / Network Icon -->
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="14"
                                        Background="#162035"
                                        BorderBrush="#1E2F4D"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE701;" FontSize="24" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Title & Diagnostic Message (Plain English, No Raw Codes) -->
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock x:Name="FallbackTitleText"
                                               Text="Unable to Reach Google Sign-In"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="FallbackMessageText"
                                               Text="Your connection to Google's authentication service could not be established. You can retry, authenticate through the campus portal, or request an invigilator bypass."
                                               FontSize="13"
                                               Foreground="#94A3B8"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Primary Action: Try Again -->
                                <Button Click="FallbackRetry_Click"
                                        Width="380"
                                        Height="44"
                                        Background="#0066FF"
                                        Foreground="#FFFFFF"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        CornerRadius="8"
                                        BorderThickness="0"
                                        Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock Text="Try Again in App" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Primary-B Action: Sign in with Default Browser (Recommended) -->
                                <Button Click="SystemBrowserSignIn_Click"
                                        Width="380"
                                        Height="40"
                                        Background="#162035"
                                        BorderBrush="#2563EB"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock Text="Sign in with Default Browser" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Secondary Action: Open Campus Wi-Fi Portal -->
                                <Button Click="FallbackPortal_Click"
                                        Width="380"
                                        Height="40"
                                        Background="#1E293B"
                                        Foreground="#CBD5E1"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        CornerRadius="8"
                                        BorderBrush="#334155"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <TextBlock Text="Open Campus Wi-Fi Portal" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Tertiary Action: Invigilator Offline Bypass -->
                                <Button Click="OpenInvigilatorBypass_Click"
                                        Width="380"
                                        Height="36"
                                        Background="Transparent"
                                        Foreground="#60A5FA"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        CornerRadius="6"
                                        BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#60A5FA" VerticalAlignment="Center" />
                                        <TextBlock Text="Invigilator Offline Bypass" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Back / Cancel Button -->
                                <Button Click="CloseGoogleAuth_Click"
                                        HorizontalAlignment="Center"
                                        Background="Transparent"
                                        Foreground="#64748B"
                                        FontSize="12"
                                        BorderThickness="0"
                                        Content="Return to Setup" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- INVIGILATOR OFFLINE AUTHORIZATION MODAL                      -->
        <!-- ============================================================ -->
        <Grid x:Name="InvigilatorBypassModal"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Background="#D9000000"
              Visibility="Collapsed">
            <Border Width="400"
                    Background="#131B2E"
                    BorderBrush="#253554"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <!-- Icon + Title -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#1E2A47" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Invigilator Authorization" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Offline Exam Hall Bypass" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="If external Google services or the campus WAN is temporarily unavailable, the examination invigilator may authorize this workstation using the proctor PIN."
                               FontSize="13"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"
                               LineHeight="18" />

                    <!-- PIN Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Invigilator PIN" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                        <PasswordBox x:Name="InvigilatorPinBox"
                                     PlaceholderText="Enter 6-digit invigilator PIN"
                                     MaxLength="12"
                                     Height="42"
                                     CornerRadius="8"
                                     Background="#0F1422"
                                     BorderBrush="#1E293B"
                                     Foreground="#FFFFFF"
                                     KeyDown="InvigilatorPinBox_KeyDown" />
                        <TextBlock x:Name="InvigilatorPinError"
                                   Text="Incorrect PIN. Please re-enter or contact chief superintendent."
                                   FontSize="12"
                                   Foreground="#EF4444"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Click="CancelInvigilatorPin_Click"
                                Height="42"
                                HorizontalAlignment="Stretch"
                                Background="#1E293B"
                                Foreground="#94A3B8"
                                CornerRadius="8"
                                BorderThickness="0"
                                FontSize="13" />

                        <Button Grid.Column="2"
                                x:Name="AuthorizePinButton"
                                Content="Authorize &amp; Continue"
                                Click="VerifyInvigilatorPin_Click"
                                Height="42"
                                HorizontalAlignment="Stretch"
                                Background="#0066FF"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                CornerRadius="8"
                                BorderThickness="0"
                                FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
