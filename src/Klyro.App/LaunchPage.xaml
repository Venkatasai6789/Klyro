<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Klyro_App.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Klyro_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <!-- Root 50/50 Split Container matching 1536 x 1024 reference layout -->
    <Grid x:Name="RootGrid" Background="#0F1219">
        <Grid.ColumnDefinitions>
            <!-- Left Branding Panel (exact 50% width) -->
            <ColumnDefinition Width="1*" />
            <!-- Right Content & Status Panel (exact 50% width) -->
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Background Artwork (Full Window 1.5 aspect ratio, preserving circular spiral geometry) -->
        <Image Source="ms-appx:///Assets/StartUp_Screen_Bg.png"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               IsHitTestVisible="False" />

        <!-- ============================================================ -->
        <!-- LEFT PANEL: Visual Artwork & Centered Klyro Logo             -->
        <!-- ============================================================ -->
        <Grid Grid.Column="0"
              Background="Transparent"
              PointerPressed="TitleBar_PointerPressed">

            <!-- Official Klyro Logo (295 x 295 DIPs = 442 physical px, shifted upward into the visual eye of the spiral) -->
            <Image Source="ms-appx:///Assets/Klyro_Logo.png"
                   Width="295"
                   Height="295"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="8,-53,0,0"
                   IsHitTestVisible="False" />
        </Grid>

        <!-- ============================================================ -->
        <!-- RIGHT PANEL: Window Controls, Brand Info, Progress & Features-->
        <!-- ============================================================ -->
        <Grid Grid.Column="1" Background="#0F1219">
            <Grid.RowDefinitions>
                <!-- Top Title / Window Control Bar (44px) -->
                <RowDefinition Height="Auto" />
                <!-- Main Content Area -->
                <RowDefinition Height="*" />
                <!-- Feature Highlights Footer Area -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top Drag Bar and Native-style Window Controls in Top-Right Corner -->
            <Grid Grid.Row="0"
                  Height="44"
                  Background="Transparent"
                  PointerPressed="TitleBar_PointerPressed">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                <!-- Minimize Button -->
                <Button x:Name="MinimizeButton"
                        Click="Minimize_Click"
                        AutomationProperties.Name="Minimize"
                        ToolTipService.ToolTip="Minimize"
                        Width="44" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4">
                    <FontIcon Glyph="&#xE921;" FontSize="11" Foreground="#94A3B8" />
                </Button>

                <!-- Maximize / Restore Button -->
                <Button x:Name="MaximizeButton"
                        Click="Maximize_Click"
                        AutomationProperties.Name="Maximize"
                        ToolTipService.ToolTip="Maximize"
                        Width="44" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontSize="11" Foreground="#94A3B8" />
                </Button>

                <!-- Close Button -->
                <Button x:Name="CloseButton"
                        Click="Close_Click"
                        AutomationProperties.Name="Close"
                        ToolTipService.ToolTip="Close"
                        Width="44" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        PointerEntered="CloseButton_PointerEntered"
                        PointerExited="CloseButton_PointerExited">
                    <FontIcon x:Name="CloseIcon" Glyph="&#xE8BB;" FontSize="11" Foreground="#94A3B8" />
                </Button>
            </StackPanel>
            </Grid>

            <!-- 2. Main Content Stack (Title, Subtitle, Description, Progress, Status) -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="48,0,0,0"
                        MaxWidth="380">

                <!-- Brand Title: "Klyro" -->
                <TextBlock Text="Klyro"
                           FontSize="52"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           CharacterSpacing="10"
                           Margin="0,0,0,4" />

                <!-- Product Subtitle: "Secure Assessment Browser" -->
                <TextBlock Text="Secure Assessment Browser"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"
                           Margin="0,0,0,20" />

                <!-- Description (Two lines on desktop) -->
                <TextBlock FontSize="15"
                           LineHeight="24"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           Margin="0,0,0,30">
                    <Run Text="A safe and controlled browsing environment" /><LineBreak />
                    <Run Text="for fair and secure assessments." />
                </TextBlock>

                <!-- Startup Horizontal Progress Bar Track (380 x 14 px) -->
                <Grid Width="380"
                      Height="14"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,14">
                    <!-- Dark Gray Track -->
                    <Border Background="#1E2638" CornerRadius="7" />

                    <!-- Blue Progress Fill Bar -->
                    <Border x:Name="ProgressBarFill"
                            Width="0"
                            Height="14"
                            Background="#0066FF"
                            CornerRadius="7"
                            HorizontalAlignment="Left" />
                </Grid>

                <!-- Dynamic Status Text -->
                <TextBlock x:Name="StatusTextBlock"
                           Text="Starting Klyro..."
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="#94A3B8"
                           Margin="0,0,0,0" />

                <!-- Startup Error Card (Displayed only when initialization fails) -->
                <Border x:Name="StartupErrorCard"
                        Background="#1C1418"
                        BorderBrush="#7F1D1D"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,18,0,0"
                        MaxWidth="380"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB55;" FontSize="16" Foreground="#EF4444" VerticalAlignment="Center" />
                            <TextBlock x:Name="StartupErrorMessage"
                                       Text="Startup check failed."
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FCA5A5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RetryButton"
                                    Content="Retry Startup"
                                    Click="Retry_Click"
                                    Background="#2563EB"
                                    Foreground="#FFFFFF"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Padding="16,6"
                                    CornerRadius="6" />
                            <Button Content="Exit"
                                    Click="Close_Click"
                                    Background="#1E293B"
                                    Foreground="#CBD5E1"
                                    FontSize="12"
                                    Padding="16,6"
                                    CornerRadius="6" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Feature Indicators Row (Bottom of Right Panel) -->
            <Grid Grid.Row="2"
                  Width="380"
                  HorizontalAlignment="Left"
                  Margin="48,0,0,48">
                <Grid.ColumnDefinitions>
                    <!-- Feature 1: Secure Environment -->
                    <ColumnDefinition Width="125" />
                    <!-- Vertical Separator 1 -->
                    <ColumnDefinition Width="1" />
                    <!-- Feature 2: Distraction Free -->
                    <ColumnDefinition Width="128" />
                    <!-- Vertical Separator 2 -->
                    <ColumnDefinition Width="1" />
                    <!-- Feature 3: Trusted by Institutions -->
                    <ColumnDefinition Width="125" />
                </Grid.ColumnDefinitions>

                <!-- FEATURE 1: Secure Environment -->
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="44" Height="44"
                            CornerRadius="10"
                            Background="#131B2E"
                            BorderBrush="#1E2C48"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Secure_Environment.png"
                               Width="26" Height="26"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                    <TextBlock FontSize="12"
                               FontWeight="Medium"
                               Foreground="#94A3B8"
                               TextAlignment="Center"
                               LineHeight="16"
                               Margin="0,8,0,0">
                        <Run Text="Secure" /><LineBreak />
                        <Run Text="Environment" />
                    </TextBlock>
                </StackPanel>

                <!-- Vertical Separator 1 -->
                <Border Grid.Column="1"
                        Width="1"
                        Height="48"
                        Background="#1E293B"
                        VerticalAlignment="Center" />

                <!-- FEATURE 2: Distraction Free -->
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="44" Height="44"
                            CornerRadius="10"
                            Background="#131B2E"
                            BorderBrush="#1E2C48"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/distraction_free.png"
                               Width="26" Height="26"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                    <TextBlock FontSize="12"
                               FontWeight="Medium"
                               Foreground="#94A3B8"
                               TextAlignment="Center"
                               LineHeight="16"
                               Margin="0,8,0,0">
                        <Run Text="Distraction" /><LineBreak />
                        <Run Text="Free" />
                    </TextBlock>
                </StackPanel>

                <!-- Vertical Separator 2 -->
                <Border Grid.Column="3"
                        Width="1"
                        Height="48"
                        Background="#1E293B"
                        VerticalAlignment="Center" />

                <!-- FEATURE 3: Trusted by Institutions -->
                <StackPanel Grid.Column="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="44" Height="44"
                            CornerRadius="10"
                            Background="#131B2E"
                            BorderBrush="#1E2C48"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Trusted_Instructions.png"
                               Width="26" Height="26"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                    <TextBlock FontSize="12"
                               FontWeight="Medium"
                               Foreground="#94A3B8"
                               TextAlignment="Center"
                               LineHeight="16"
                               Margin="0,8,0,0">
                        <Run Text="Trusted by" /><LineBreak />
                        <Run Text="Institutions" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
