<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Klyro_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Klyro_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <!-- Minimal institutional header bar (52px) -->
            <!-- Institutional Top Header (56px) -->
            <RowDefinition Height="56" />
            <!-- Assessment / Content area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Institutional Header & Navigation Bar (56px) -->
        <Grid Grid.Row="0" Height="56" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Identity -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#1E40AF" CornerRadius="6">
                        <FontIcon Glyph="&#xE7EF;" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="KLYRO" FontWeight="ExtraBold" FontSize="16" Foreground="#1E40AF" VerticalAlignment="Center" CharacterSpacing="30" />
                </StackPanel>
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="SECURE BROWSER" FontSize="9" FontWeight="Bold" Foreground="#2563EB" CharacterSpacing="20" />
                </Border>
                <Border Width="1" Height="22" Background="#E2E8F0" Margin="4,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Browser Navigation & Dual Tabs Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" Spacing="10">
                <!-- Segmented Dual Tab Container -->
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <!-- Tab 1: CodeChef Assessment -->
                        <Button x:Name="TabAssessmentButton" Click="TabAssessment_Click" ToolTipService.ToolTip="Switch to CodeChef Assessment" Padding="12,6" CornerRadius="6" Background="#FFFFFF" BorderBrush="#93C5FD" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BE;" FontSize="13" Foreground="#2563EB" VerticalAlignment="Center" />
                                <TextBlock x:Name="TabAssessmentText" Text="CodeChef Assessment" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Campus Wi-Fi Portal (Active in Background) -->
                        <Button x:Name="TabWifiPortalButton" Click="TabWifiPortal_Click" ToolTipService.ToolTip="Switch to Campus Wi-Fi Portal (Kept active in background)" Padding="10,6" CornerRadius="6" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="TabWifiIcon" Glyph="&#xE701;" FontSize="12" Foreground="#16A34A" VerticalAlignment="Center" />
                                <TextBlock x:Name="TabWifiTitle" Text="Campus Wi-Fi" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                <Border x:Name="WifiTabBadge" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse x:Name="WifiTabDot" Width="6" Height="6" Fill="#16A34A" VerticalAlignment="Center" />
                                        <TextBlock x:Name="WifiTabBadgeText" Text="Active in BG" FontSize="10" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Navigation Pill Container (Back, Forward, Refresh, Home) -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="NavBackButton" ToolTipService.ToolTip="Back" Click="NavBack_Click" IsEnabled="False" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="#475569" />
                        </Button>
                        <Button x:Name="NavForwardButton" ToolTipService.ToolTip="Forward" Click="NavForward_Click" IsEnabled="False" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="#475569" />
                        </Button>
                        <Button x:Name="NavRefreshButton" ToolTipService.ToolTip="Reload Current View" Click="NavRefresh_Click" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#475569" />
                        </Button>
                        <Border Width="1" Height="16" Background="#CBD5E1" Margin="3,0" VerticalAlignment="Center" />
                        <Button x:Name="NavHomeButton" ToolTipService.ToolTip="Return to CodeChef Assessment" Click="NavHome_Click" Padding="8,4" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE80F;" FontSize="12" Foreground="#D97706" VerticalAlignment="Center" />
                                <TextBlock Text="CodeChef" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Current Safe Domain Badge -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#16A34A" VerticalAlignment="Center" />
                        <TextBlock x:Name="CurrentUrlTextBlock" Text="https://www.codechef.com" FontSize="12" Foreground="#334155" FontFamily="Consolas" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Header Action Controls & Network Quality Widget -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <!-- Campus Wi-Fi Login Trigger Button (Visible only when recovery portal needed) -->
                <Button x:Name="WifiPortalButton" Click="WifiPortalButton_Click" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,6" CornerRadius="6" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE701;" FontSize="12" Foreground="#2563EB" VerticalAlignment="Center" />
                        <TextBlock Text="Campus Wi-Fi Login" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Wi-Fi Quality & Latency Badge (Click to open Wi-Fi picker) -->
                <Button x:Name="NetworkQualityButton" Click="NetworkQualityButton_Click" ToolTipService.ToolTip="Wi-Fi Signal &amp; Latency • Click to choose Wi-Fi network" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                    <Border x:Name="NetworkQualityBadge" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon x:Name="WifiSignalIcon" Glyph="&#xE701;" FontSize="13" Foreground="#16A34A" VerticalAlignment="Center" />
                            <TextBlock x:Name="WifiSignalTextBlock" Text="--%" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Text="&#x2022;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock x:Name="PingTextBlock" Text="-- ms" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Exit Assessment Button (Requires Invigilator PIN) -->
                <Button x:Name="ExitExamButton" Click="ExitExamButton_Click" Background="#FEF2F2" BorderBrush="#FECACA" Foreground="#DC2626" FontSize="12" FontWeight="Bold" Padding="12,6" CornerRadius="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7E8;" FontSize="12" Foreground="#DC2626" VerticalAlignment="Center" />
                        <TextBlock Text="Exit Exam" Foreground="#DC2626" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Dev-mode Simulator Toggle (Hidden in production) -->
            <Button x:Name="SimulatorToggleButton" Grid.Column="3" Content="Simulator" FontSize="11" Click="SimulatorToggle_Click" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0" />

            <!-- Page Loading Bar (Underneath Header) -->
            <ProgressBar x:Name="PageLoadingProgressBar" Grid.ColumnSpan="4" VerticalAlignment="Bottom" Height="2.5" IsIndeterminate="True" Visibility="Collapsed" Foreground="#2563EB" />
        </Grid>

        <!-- Primary Assessment View Area -->
        <Grid Grid.Row="1">
            <!-- CodeChef Primary WebView2 -->
            <WebView2 x:Name="ExamWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Fallback / Error Card (Shown when navigation fails) -->
            <Grid x:Name="ExamErrorOverlay" Background="#F8FAFC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="15">
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB55;" FontSize="40" Foreground="#DC2626" HorizontalAlignment="Center" />
                        <TextBlock Text="Assessment Service Unreachable" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ExamErrorMessage" Text="Unable to establish a secure connection to CodeChef. Please authenticate with campus Wi-Fi or check your internet connection." FontSize="13" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                            <Button Content="Open Campus Wi-Fi Login" Click="WifiPortalButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Retry Connection" Click="NavRefresh_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Non-intrusive notification banner (for submission retry or CodeChef outage) -->
            <InfoBar x:Name="NoticeBar" Severity="Warning" IsOpen="False" IsClosable="True" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Canvas.ZIndex="10" />

            <!-- Pre-flight Environmental Verification Screen -->
            <Grid x:Name="PreflightOverlay" Background="#F8FAFC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="440">
                    <TextBlock Text="Preparing Your Assessment Environment" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                    <TextBlock Text="Please wait while Klyro verifies device and network security policies." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" />

                    <ProgressBar x:Name="PreflightProgressBar" IsIndeterminate="True" Margin="0,8" />

                    <StackPanel x:Name="PreflightCheckList" Spacing="8" Margin="0,8">
                        <TextBlock x:Name="PfCheckSystem" Text="○ System security and operating system policy" FontSize="13" Foreground="#64748B" />
                        <TextBlock x:Name="PfCheckConfig" Text="○ Examination configuration integrity" FontSize="13" Foreground="#64748B" />
                        <TextBlock x:Name="PfCheckNetwork" Text="○ Network adapter and campus gateway reachability" FontSize="13" Foreground="#64748B" />
                        <TextBlock x:Name="PfCheckAssessment" Text="○ Assessment platform connectivity" FontSize="13" Foreground="#64748B" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button x:Name="PreflightRetryButton" Content="Retry Pre-flight Checks" Click="PreflightRetry_Click" Visibility="Collapsed" />
                        <Button x:Name="PreflightWifiButton" Click="WifiPickerOpen_Click" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE701;" FontSize="12" />
                                <TextBlock Text="Select Campus Wi-Fi" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="PreflightErrorMessage" Foreground="#DC2626" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Captive Portal Recovery Modal Overlay (Popups automatically when internet drops mid-exam; zero tab sifting) -->
            <Grid x:Name="RecoveryModalOverlay" Background="#800F172A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible" Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="0">
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Width="860" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#2563EB" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecoveryModalTitle" Text="RECONNECT INTERNET OR LOGIN TO CAMPUS WI-FI (KLU_WIFI)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="RecoveryModalSubtitle" Text="No internet connection detected. Please sign in below to restore access. Your exam progress and code are safely preserved." FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="WifiPickerOpen_Click" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE701;" FontSize="11" Foreground="#2563EB" />
                                        <TextBlock Text="Switch Wi-Fi" Foreground="#0F172A" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Reload Portal" Click="RecoveryReload_Click" FontSize="12" />
                                <Button x:Name="ModalKeepInBgButton" Click="RecoveryDismiss_Click" Background="#EFF6FF" BorderBrush="#BFDBFE" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE80F;" FontSize="11" Foreground="#2563EB" />
                                        <TextBlock Text="Return to Exam (Active in BG)" Foreground="#1D4ED8" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Status Message / Verification spinner -->
                        <StackPanel x:Name="RecoveryStatusPanel" Grid.Row="1" Margin="0,10" Spacing="6" Visibility="Collapsed">
                            <ProgressBar x:Name="RecoveryProgressBar" IsIndeterminate="True" />
                            <TextBlock x:Name="RecoveryStatusText" Text="Authenticating... verifying Internet connection" FontSize="12" Foreground="#2563EB" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Isolated Captive Portal WebView2 Control -->
                        <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,8">
                            <WebView2 x:Name="RecoveryWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>

                        <!-- Modal Footer Notice -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#16A34A" />
                                <TextBlock Text="This portal stays active in the background without closing to prevent campus Wi-Fi disconnection." FontSize="12" Foreground="#166534" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="RecoveryRetryButton" Content="Check Connection Now" Click="RecoveryRetry_Click" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Wi-Fi Network Picker Modal Overlay -->
            <Grid x:Name="WifiPickerOverlay" Background="#990F172A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="45" Tapped="WifiPickerOverlay_Tapped">
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Width="520" MaxHeight="600" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="DialogContent_Tapped">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="#2563EB" VerticalAlignment="Center" />
                                    <TextBlock Text="AVAILABLE WI-FI NETWORKS" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Connect to campus Wi-Fi or lab APs. University portal validates automatically." FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Button x:Name="WifiRefreshButton" Click="WifiRefresh_Click" ToolTipService.ToolTip="Rescan Networks" Width="34" Height="34" Padding="0" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="#475569" />
                                </Button>
                                <Button x:Name="WifiPickerCloseButton" Click="WifiPickerClose_Click" ToolTipService.ToolTip="Close Wi-Fi Menu" Height="34" Padding="12,0" CornerRadius="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#475569" />
                                        <TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Connecting Status Banner -->
                        <Border x:Name="WifiConnectingBanner" Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressRing Width="18" Height="18" IsActive="True" />
                                <TextBlock x:Name="WifiConnectingText" Text="Connecting to campus Wi-Fi..." FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Network List -->
                        <ScrollViewer Grid.Row="2" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="WifiNetworksListPanel" Spacing="6">
                                <!-- Dynamic Wi-Fi cards added programmatically -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Password Card (Appears if user selects secured network without saved profile) -->
                        <StackPanel x:Name="WifiPasswordCard" Grid.Row="3" Margin="0,14,0,0" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="WifiPasswordPromptText" Text="Enter Wi-Fi Password:" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                            <PasswordBox x:Name="WifiPasswordInput" PlaceholderText="Password" KeyDown="WifiPasswordInput_KeyDown" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="Cancel" Click="WifiPasswordCancel_Click" FontSize="12" />
                                <Button Content="Connect" Click="WifiPasswordSubmit_Click" Style="{StaticResource AccentButtonStyle}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Modal Footer / Action Bar with Close Button -->
                        <Grid Grid.Row="4" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <TextBlock Text="Click any network to connect" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="↻ Rescan" Click="WifiRefresh_Click" FontSize="12" Padding="12,5" CornerRadius="6" />
                                <Button Content="✕ Close Menu" Click="WifiPickerClose_Click" Style="{StaticResource AccentButtonStyle}" Background="#334155" BorderBrush="#334155" FontSize="12" FontWeight="SemiBold" Padding="16,5" CornerRadius="6" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Invigilator Exit PIN Dialog Modal Overlay -->
            <Grid x:Name="PinModalOverlay" Background="#990F172A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="50">
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Width="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="INVIGILATOR AUTHORIZATION" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Enter the 6-digit invigilator PIN to close or exit the examination browser." FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>

                        <PasswordBox x:Name="ExitPinPasswordBox" PlaceholderText="Enter 6-digit PIN" MaxLength="10" FontSize="16" KeyDown="ExitPinPasswordBox_KeyDown" HorizontalAlignment="Stretch" Margin="0,8,0,0" />

                        <TextBlock x:Name="PinErrorMessage" Text="Invalid Invigilator PIN. Examination remains locked." Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
                            <Button Content="Cancel" Click="CancelPin_Click" />
                            <Button Content="Authorize &amp; Exit" Click="AuthorizePin_Click" Style="{StaticResource AccentButtonStyle}" Background="#DC2626" BorderBrush="#DC2626" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Developer Network Simulator Drawer (Debug / Dev only) -->
            <Border x:Name="SimulatorDrawer" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Padding="12" Visibility="Collapsed" Canvas.ZIndex="40">
                <StackPanel Spacing="8">
                    <TextBlock Text="Network Simulator (Dev)" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                    <Button Content="Simulate Normal" Click="SimNormal_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Simulate Portal Required" Click="SimPortalReq_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Simulate Degraded" Click="SimDegraded_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Simulate Offline" Click="SimOffline_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Simulate CodeChef Outage" Click="SimChefDown_Click" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
