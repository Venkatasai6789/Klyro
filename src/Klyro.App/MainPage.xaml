<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Klyro_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Klyro_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid Background="#0B0F17">
        <Grid.RowDefinitions>
            <!-- Browser Chrome: Tab Strip (Row 0) + Navigation Toolbar (Row 1) -->
            <RowDefinition Height="Auto" />
            <!-- Assessment / Content area -->
            <RowDefinition Height="*" />
            <!-- Status bar (32px) -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- BROWSER CHROME (Tab Row + Navigation Toolbar)                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <!-- Row 1: Browser Tab Strip (Height 38px) -->
            <Grid Height="38" Background="#070A11" BorderBrush="#162032" BorderThickness="0,0,0,1" Padding="14,4,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Brand Emblem + Tabs Strip -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <!-- Brand Icon -->
                    <Border Width="24" Height="24" CornerRadius="12" Background="#131B2E" BorderBrush="#253554" BorderThickness="1" Margin="0,0,6,4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Klyro_Logo.png" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Tab 1: Single Assessment Tab (Assessment Home / CodeChef) -->
                    <Button x:Name="TabAssessmentButton"
                            Click="TabAssessment_Click"
                            ToolTipService.ToolTip="Switch to Assessment View"
                            Height="34"
                            Padding="12,0"
                            CornerRadius="8,8,0,0"
                            Background="#0B0F17"
                            BorderBrush="#1E293B"
                            BorderThickness="1,1,1,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/Klyro_Logo.png" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock x:Name="TabAssessmentText" Text="Assessment Home" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Tab 2: Campus Wi-Fi Portal Tab (Active in Background) -->
                    <Button x:Name="TabWifiPortalButton"
                            Click="TabWifiPortal_Click"
                            ToolTipService.ToolTip="Switch to Campus Wi-Fi Portal (Kept active in background)"
                            Height="34"
                            Padding="12,0"
                            CornerRadius="8,8,0,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1,1,1,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="TabWifiIcon" Glyph="&#xE701;" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" />
                            <TextBlock x:Name="TabWifiTitle" Text="Campus Wi-Fi" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <Border x:Name="WifiTabBadge" Background="#062E16" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Ellipse x:Name="WifiTabDot" Width="5" Height="5" Fill="#10B981" VerticalAlignment="Center" />
                                    <TextBlock x:Name="WifiTabBadgeText" Text="Active in BG" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Institutional Tag (No minimize, maximize, or close buttons) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,4,4">
                    <Border Background="#162238" BorderBrush="#253554" BorderThickness="1" CornerRadius="6" Padding="6,2">
                        <TextBlock Text="SECURE EXAM KIOSK" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="20" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Row 2: Navigation Toolbar & Search Bar (Height 48px) -->
            <Grid Height="48" Background="#0B0F17" BorderBrush="#162032" BorderThickness="0,0,0,1" Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Action Buttons (Back, Forward, Refresh, Home) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="NavBackButton"
                            ToolTipService.ToolTip="Back (Return to Assessment Home if at start)"
                            Click="NavBack_Click"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="#64748B" />
                    </Button>
                    <Button x:Name="NavForwardButton"
                            ToolTipService.ToolTip="Forward"
                            Click="NavForward_Click"
                            IsEnabled="False"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="#64748B" />
                    </Button>
                    <Button x:Name="NavRefreshButton"
                            ToolTipService.ToolTip="Reload Current View"
                            Click="NavRefresh_Click"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#94A3B8" />
                    </Button>
                    <Border Width="1" Height="16" Background="#1E293B" Margin="4,0" VerticalAlignment="Center" />
                    <Button x:Name="NavHomeButton"
                            ToolTipService.ToolTip="Return to Assessment Home"
                            Click="NavHome_Click"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE80F;" FontSize="13" Foreground="#38BDF8" />
                    </Button>
                </StackPanel>

                <!-- Primary Toolbar Address / Search Bar -->
                <Border Grid.Column="1"
                        Background="#131B2E"
                        BorderBrush="#253554"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="36"
                        MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Margin="14,0"
                        Padding="12,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="CurrentUrlTextBox"
                                 Grid.Column="1"
                                 PlaceholderText="Search or enter an allowed URL"
                                 Text=""
                                 FontSize="12"
                                 FontFamily="Consolas"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 KeyDown="CurrentUrlTextBox_KeyDown" />
                        <Button Grid.Column="2"
                                Click="ToolbarGo_Click"
                                ToolTipService.ToolTip="Go to URL"
                                Width="26" Height="26" Padding="0"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="#64748B" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Header Controls: Wi-Fi Badge + Profile Icon -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <!-- Campus Wi-Fi Login Button (Visible when recovery portal is needed) -->
                    <Button x:Name="WifiPortalButton" Click="WifiPortalButton_Click" Background="#162238" BorderBrush="#253554" BorderThickness="1" Padding="10,5" CornerRadius="8" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="Campus Wi-Fi Login" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Network Quality & Latency Badge -->
                    <Button x:Name="NetworkQualityButton"
                            Click="NetworkQualityButton_Click"
                            ToolTipService.ToolTip="Wi-Fi Signal &amp; Latency • Click to manage Wi-Fi"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8">
                        <Border x:Name="NetworkQualityBadge" Background="#131B2E" BorderBrush="#253554" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="WifiSignalIcon" Glyph="&#xE701;" FontSize="12" Foreground="#10B981" VerticalAlignment="Center" />
                                <TextBlock x:Name="WifiSignalTextBlock" Text="--%" FontSize="11.5" FontWeight="Bold" Foreground="#E6EDF3" VerticalAlignment="Center" />
                                <TextBlock Text="•" FontSize="10" Foreground="#475569" VerticalAlignment="Center" />
                                <TextBlock x:Name="PingTextBlock" Text="-- ms" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Profile Avatar Icon -->
                    <Button x:Name="ProfileButton"
                            Click="ProfileButton_Click"
                            ToolTipService.ToolTip="Candidate Profile &amp; Exit Options"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="17"
                            Width="34" Height="34"
                            VerticalAlignment="Center">
                        <Grid Width="34" Height="34">
                            <!-- Initials Circle -->
                            <Ellipse x:Name="ProfileInitialsCircle" Width="34" Height="34" Fill="#162238" Stroke="#253554" StrokeThickness="1.5" />
                            <TextBlock x:Name="ProfileInitialsText" Text="GU" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- Photo Circle (if Google photo loads) -->
                            <Ellipse x:Name="ProfilePhotoCircle" Width="34" Height="34" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="ProfilePhotoBrush" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="#253554" />
                                </Ellipse.Stroke>
                                <Ellipse.StrokeThickness>1.5</Ellipse.StrokeThickness>
                            </Ellipse>
                        </Grid>
                    </Button>

                    <!-- Dev-mode Simulator Toggle -->
                    <Button x:Name="SimulatorToggleButton" Content="Simulator" FontSize="11" Click="SimulatorToggle_Click" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- Page Loading Bar -->
            <ProgressBar x:Name="PageLoadingProgressBar" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" Visibility="Collapsed" Foreground="#0066FF" />
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- PRIMARY ASSESSMENT VIEW AREA & HOME PAGE                       -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <!-- Primary Assessment WebView2 (CodeChef runs here, Collapsed by default until launched) -->
            <WebView2 x:Name="ExamWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" />

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- BROWSER HOME PAGE (Assessment Home Screen Overlay)          -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid x:Name="ExamHomePageOverlay" Background="#0B0F17" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible" Canvas.ZIndex="10">
                <!-- Ambient Glow Decoration -->
                <Ellipse Width="720" Height="720" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#221075FE" Offset="0.0" />
                            <GradientStop Color="#0A38BDF8" Offset="0.55" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28" MaxWidth="820">
                    <!-- Brand Emblem -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <Border Width="96" Height="96" CornerRadius="48" Background="#0C1424" BorderBrush="#253554" BorderThickness="1.5" />
                        <Image Source="ms-appx:///Assets/Klyro_Logo.png" Width="60" Height="60" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Hero Title & Subtitle -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="Ready for your" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="assessment" FontSize="32" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Access only the websites approved for this assessment." FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Hero Search / Address Bar (Border radius consistent with onboarding screen button design) -->
                    <Border Width="660" Height="52" CornerRadius="10" Background="#131B2E" BorderBrush="#253554" BorderThickness="1.5" Padding="16,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBox x:Name="HomeSearchTextBox"
                                     Grid.Column="1"
                                     PlaceholderText="Search or enter an allowed URL"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     FontSize="14"
                                     Padding="12,0"
                                     VerticalAlignment="Center"
                                     KeyDown="HomeSearchTextBox_KeyDown" />
                            <Button x:Name="HomeSearchGoButton"
                                    Grid.Column="2"
                                    Click="HomeSearchGo_Click"
                                    ToolTipService.ToolTip="Go to website"
                                    Width="42" Height="38"
                                    CornerRadius="8"
                                    Background="#0066FF"
                                    BorderThickness="0"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72A;" FontSize="13" Foreground="#FFFFFF" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Allowed Websites Section Header -->
                    <StackPanel Spacing="16" Width="760" HorizontalAlignment="Center">
                        <Grid Width="760">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="3.5" Height="18" Background="#38BDF8" CornerRadius="2" />
                                <TextBlock Text="Allowed websites" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="Only approved websites can be opened during this assessment." FontSize="12" Foreground="#64748B" />
                                </StackPanel>
                                <Border Background="#162238" BorderBrush="#253554" BorderThickness="1" CornerRadius="8" Padding="10,3">
                                    <TextBlock Text="2 websites approved" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Allowed Websites Cards Container -->
                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left">
                            <!-- CodeChef Approved Website Card -->
                            <Button x:Name="CodeChefCardButton"
                                    Click="CodeChefCard_Click"
                                    ToolTipService.ToolTip="Launch CodeChef Assessment"
                                    Width="220" Height="150"
                                    Padding="18,16"
                                    CornerRadius="10"
                                    Background="#131B2E"
                                    BorderBrush="#253554"
                                    BorderThickness="1.5">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Emblem -->
                                        <Border Width="48" Height="48" CornerRadius="10" Background="#1E2A47" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BE;" FontSize="22" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Title & Domain -->
                                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                                            <TextBlock Text="CodeChef" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            <TextBlock Text="codechef.com" FontSize="11.5" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <!-- Status Badge -->
                                        <Border Background="#062E16" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="Approved Platform" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Google Forms Approved Website Card -->
                            <Button x:Name="GoogleFormCardButton"
                                    Click="GoogleFormCard_Click"
                                    ToolTipService.ToolTip="Launch Google Form Assessment"
                                    Width="220" Height="150"
                                    Padding="18,16"
                                    CornerRadius="10"
                                    Background="#131B2E"
                                    BorderBrush="#253554"
                                    BorderThickness="1.5">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Emblem -->
                                        <Border Width="48" Height="48" CornerRadius="10" Background="#241838" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Title & Domain -->
                                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                                            <TextBlock Text="Google Forms" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            <TextBlock Text="docs.google.com" FontSize="11.5" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <!-- Status Badge -->
                                        <Border Background="#062E16" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="Approved Form" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- BLOCKED URL OVERLAY — Clean Text, No Button                -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid x:Name="BlockedUrlOverlay" Background="#E60B0F17" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="30" Tapped="BlockedUrlOverlay_Tapped">
                <Border Background="#131B2E" BorderBrush="#253554" BorderThickness="1" CornerRadius="14" Width="440" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="DialogContent_Tapped">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="#26181A" BorderBrush="#7F1D1D" BorderThickness="1" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="24" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="You don't have access to this website" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Contact admin" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Fallback / Error Card (Shown when navigation fails) -->
            <Grid x:Name="ExamErrorOverlay" Background="#0B0F17" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="15">
                <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB55;" FontSize="40" Foreground="#EF4444" HorizontalAlignment="Center" />
                        <TextBlock Text="Assessment Service Unreachable" FontSize="18" FontWeight="Bold" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ExamErrorMessage" Text="Unable to establish a secure connection to CodeChef. Please authenticate with campus Wi-Fi or check your internet connection." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                            <Button Content="Open Campus Wi-Fi Login" Click="WifiPortalButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Retry Connection" Click="NavRefresh_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Non-intrusive notification banner -->
            <InfoBar x:Name="NoticeBar" Severity="Warning" IsOpen="False" IsClosable="True" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Canvas.ZIndex="10" />

            <!-- Pre-flight Environmental Verification Screen -->
            <Grid x:Name="PreflightOverlay" Background="#0B0F17" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="440">
                    <TextBlock Text="Preparing Your Assessment Environment" FontSize="20" FontWeight="Bold" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                    <TextBlock Text="Please wait while Klyro verifies device and network security policies." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="PreflightProgressBar" IsIndeterminate="True" Margin="0,8" />
                    <StackPanel x:Name="PreflightCheckList" Spacing="8" Margin="0,8">
                        <TextBlock x:Name="PfCheckSystem" Text="○ System security and operating system policy" FontSize="13" Foreground="#94A3B8" />
                        <TextBlock x:Name="PfCheckConfig" Text="○ Examination configuration integrity" FontSize="13" Foreground="#94A3B8" />
                        <TextBlock x:Name="PfCheckNetwork" Text="○ Network adapter and campus gateway reachability" FontSize="13" Foreground="#94A3B8" />
                        <TextBlock x:Name="PfCheckAssessment" Text="○ Assessment platform connectivity" FontSize="13" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button x:Name="PreflightRetryButton" Content="Retry Pre-flight Checks" Click="PreflightRetry_Click" Visibility="Collapsed" />
                        <Button x:Name="PreflightWifiButton" Click="WifiPickerOpen_Click" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE701;" FontSize="12" />
                                <TextBlock Text="Select Campus Wi-Fi" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="PreflightErrorMessage" Foreground="#EF4444" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Captive Portal Recovery Modal Overlay (Kept active in background) -->
            <Grid x:Name="RecoveryModalOverlay" Background="#D9000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible" Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="0">
                <Border Background="#131B2E" BorderBrush="#253554" BorderThickness="1" CornerRadius="14" Width="860" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecoveryModalTitle" Text="RECONNECT INTERNET OR LOGIN TO CAMPUS WI-FI (KLU_WIFI)" FontSize="14" FontWeight="Bold" Foreground="#E6EDF3" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="RecoveryModalSubtitle" Text="No internet connection detected. Please sign in below to restore access. Your exam progress and code are safely preserved." FontSize="12" Foreground="#94A3B8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="WifiPickerOpen_Click" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE701;" FontSize="11" Foreground="#38BDF8" />
                                        <TextBlock Text="Switch Wi-Fi" Foreground="#E6EDF3" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Reload Portal" Click="RecoveryReload_Click" FontSize="12" />
                                <Button x:Name="ModalKeepInBgButton" Click="RecoveryDismiss_Click" Background="#162238" BorderBrush="#253554" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE80F;" FontSize="11" Foreground="#38BDF8" />
                                        <TextBlock Text="Return to Exam (Active in BG)" Foreground="#38BDF8" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Status Message -->
                        <StackPanel x:Name="RecoveryStatusPanel" Grid.Row="1" Margin="0,10" Spacing="6" Visibility="Collapsed">
                            <ProgressBar x:Name="RecoveryProgressBar" IsIndeterminate="True" />
                            <TextBlock x:Name="RecoveryStatusText" Text="Authenticating... verifying Internet connection" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Isolated Captive Portal WebView2 Control -->
                        <Border Grid.Row="2" BorderBrush="#253554" BorderThickness="1" CornerRadius="8" Margin="0,8">
                            <WebView2 x:Name="RecoveryWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>

                        <!-- Modal Footer Notice -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#10B981" />
                                <TextBlock Text="This portal stays active in the background without closing to prevent campus Wi-Fi disconnection." FontSize="12" Foreground="#10B981" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="RecoveryRetryButton" Content="Check Connection Now" Click="RecoveryRetry_Click" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- GNOME-STYLE EXPANDABLE WI-FI DROPDOWN                      -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid x:Name="WifiDropdownOverlay" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="45" Tapped="WifiDropdownOverlay_Tapped">
                <Border Background="#131B2E" BorderBrush="#253554" BorderThickness="1" CornerRadius="14" Width="380" MaxHeight="540" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,70,0" Padding="18" Tapped="DialogContent_Tapped">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header with Rescan -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE701;" FontSize="15" Foreground="#38BDF8" />
                                <TextBlock Text="WI-FI NETWORKS" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                            </StackPanel>
                            <Button x:Name="WifiRefreshButton" Grid.Column="1" Click="WifiRefresh_Click" ToolTipService.ToolTip="Rescan Networks" Height="30" Padding="10,0" CornerRadius="6" Background="#162238" BorderBrush="#253554" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#38BDF8" />
                                    <TextBlock Text="Scan" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Connected Network Card -->
                        <Border x:Name="WifiCurrentConnectedCard" Grid.Row="1" Background="#162238" BorderBrush="#253554" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="WifiCurrentSsidText" Text="Connected Wi-Fi" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="WifiCurrentSignalText" Text="Signal: --%" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock Text="•" FontSize="10" Foreground="#64748B" />
                                        <TextBlock x:Name="WifiCurrentPingText" Text="Ping: -- ms" FontSize="11" Foreground="#10B981" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#062E16" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Connected" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Connecting status banner -->
                        <Border x:Name="WifiConnectingBanner" Grid.Row="2" Background="#162238" BorderBrush="#253554" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="16" Height="16" IsActive="True" />
                                <TextBlock x:Name="WifiConnectingText" Text="Connecting..." FontSize="11.5" Foreground="#38BDF8" />
                            </StackPanel>
                        </Border>

                        <!-- Scrollable Networks List -->
                        <ScrollViewer Grid.Row="3" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="WifiNetworksListPanel" Spacing="6">
                                <!-- Cards added dynamically -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Inline Password Card -->
                        <StackPanel x:Name="WifiPasswordCard" Grid.Row="4" Margin="0,12,0,0" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="WifiPasswordPromptText" Text="Enter Wi-Fi Password:" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3" />
                            <PasswordBox x:Name="WifiPasswordInput" PlaceholderText="Password" KeyDown="WifiPasswordInput_KeyDown" Background="#0F1219" Foreground="#FFFFFF" BorderBrush="#253554" CornerRadius="6" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="Cancel" Click="WifiPasswordCancel_Click" FontSize="11.5" Background="#162238" Foreground="#94A3B8" CornerRadius="6" BorderThickness="0" />
                                <Button Content="Connect" Click="WifiPasswordSubmit_Click" Style="{StaticResource AccentButtonStyle}" FontSize="11.5" Background="#0066FF" CornerRadius="6" BorderThickness="0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- GNOME-STYLE EXPANDABLE PROFILE DROPDOWN                    -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid x:Name="ProfileDropdownOverlay" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="46" Tapped="ProfileDropdownOverlay_Tapped">
                <Border Background="#131B2E" BorderBrush="#253554" BorderThickness="1" CornerRadius="14" Width="290" Padding="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,16,0" Tapped="DialogContent_Tapped">
                    <StackPanel Spacing="12">
                        <!-- User Card -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid Width="42" Height="42" VerticalAlignment="Center">
                                <Ellipse Width="42" Height="42" Fill="#162238" Stroke="#253554" StrokeThickness="1.5" />
                                <TextBlock x:Name="DropdownInitialsText" Text="GU" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse x:Name="DropdownPhotoCircle" Width="42" Height="42" Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="DropdownPhotoBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                    <Ellipse.Stroke>
                                        <SolidColorBrush Color="#253554" />
                                    </Ellipse.Stroke>
                                    <Ellipse.StrokeThickness>1.5</Ellipse.StrokeThickness>
                                </Ellipse>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="DropdownDisplayName" Text="Candidate" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock x:Name="DropdownEmail" Text="email@example.com" FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#1E293B" Margin="-4,0" />

                        <!-- Logout Action -->
                        <Button x:Name="LogoutButton" Click="LogoutButton_Click" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,8" CornerRadius="6">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8AB;" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Logout" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <TextBlock Text="Clear Google session &amp; sign in again" FontSize="10.5" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Exit Action (Requires PIN) -->
                        <Button x:Name="ExitButton" Click="ExitExamButton_Click" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,8" CornerRadius="6">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Exit Assessment" FontSize="13" FontWeight="Bold" Foreground="#EF4444" />
                                    <TextBlock Text="Requires Invigilator PIN" FontSize="10.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- INVIGILATOR EXIT PIN MODAL (Reusing & Elevating LaunchPage PIN UI) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid x:Name="PinModalOverlay"
                  Background="#E6050810"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Visibility="Collapsed"
                  Canvas.ZIndex="50"
                  Tapped="PinModalOverlay_Tapped"
                  KeyDown="PinModalOverlay_KeyDown">
                <Border Width="430"
                        Background="#131B2E"
                        BorderBrush="#253554"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Tapped="DialogContent_Tapped">
                    <StackPanel Spacing="18">
                        <!-- Header with Icon Badge, Titles & Dismiss Button -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon + Title Stack -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="10" Background="#1E2A47" BorderBrush="#2B3D63" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="19" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Invigilator Authorization" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Exit Examination Session" FontSize="12" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Close / Dismiss (X) Button -->
                            <Button Grid.Column="1"
                                    x:Name="PinCloseButton"
                                    Click="CancelPin_Click"
                                    ToolTipService.ToolTip="Close and return to assessment (Esc)"
                                    Width="32" Height="32"
                                    Padding="0"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#64748B" />
                            </Button>
                        </Grid>

                        <!-- Contextual Security Callout -->
                        <Border Background="#0D1322"
                                BorderBrush="#1C273C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="Exiting will terminate the secure testing kiosk and unlock workstation controls. Authorized proctor verification is required."
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           LineHeight="17" />
                            </Grid>
                        </Border>

                        <!-- PIN Input -->
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Invigilator PIN" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Left" />
                                <TextBlock Text="Required" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                            </Grid>

                            <PasswordBox x:Name="ExitPinPasswordBox"
                                         PlaceholderText="Enter 6-digit invigilator PIN"
                                         MaxLength="12"
                                         Height="42"
                                         CornerRadius="8"
                                         Background="#0F1422"
                                         BorderBrush="#1E293B"
                                         BorderThickness="1"
                                         Foreground="#FFFFFF"
                                         PasswordRevealMode="Peek"
                                         PasswordChanged="ExitPinPasswordBox_PasswordChanged"
                                         KeyDown="ExitPinPasswordBox_KeyDown" />

                            <!-- Rich Error Panel -->
                            <StackPanel x:Name="PinErrorPanel"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="Collapsed"
                                        Margin="0,2,0,0">
                                <FontIcon Glyph="&#xEB90;" FontSize="13" Foreground="#EF4444" VerticalAlignment="Center" />
                                <TextBlock x:Name="PinErrorMessage"
                                           Text="Incorrect PIN. Please re-enter or contact chief superintendent."
                                           FontSize="12"
                                           Foreground="#EF4444"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    x:Name="CancelPinButton"
                                    Content="Cancel &amp; Return"
                                    Click="CancelPin_Click"
                                    Height="42"
                                    HorizontalAlignment="Stretch"
                                    Background="#1E293B"
                                    Foreground="#94A3B8"
                                    FontWeight="SemiBold"
                                    CornerRadius="8"
                                    BorderThickness="0"
                                    FontSize="13" />

                            <Button Grid.Column="2"
                                    x:Name="AuthorizePinButton"
                                    Click="AuthorizePin_Click"
                                    Height="42"
                                    HorizontalAlignment="Stretch"
                                    Background="#DC2626"
                                    Foreground="#FFFFFF"
                                    FontWeight="SemiBold"
                                    CornerRadius="8"
                                    BorderThickness="0"
                                    FontSize="13">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <TextBlock Text="Authorize &amp; Exit" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Developer Network Simulator Drawer (Debug / Dev only) -->
            <Border x:Name="SimulatorDrawer" Background="#131B2E" BorderBrush="#253554" BorderThickness="1" CornerRadius="8" Width="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Padding="12" Visibility="Collapsed" Canvas.ZIndex="40">
                <StackPanel Spacing="8">
                    <TextBlock Text="Network Simulator (Dev)" FontWeight="Bold" FontSize="13" Foreground="#E6EDF3" />
                    <Button Content="Simulate Normal" Click="SimNormal_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Simulate Portal Required" Click="SimPortalReq_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Simulate Degraded" Click="SimDegraded_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Simulate Offline" Click="SimOffline_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Simulate CodeChef Outage" Click="SimChefDown_Click" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- STATUS BAR / FOOTER (32px)                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Height="32" Background="#070A11" BorderBrush="#162032" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Left: Mode and security indicators -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" VerticalAlignment="Center" />
                <TextBlock Text="Secure assessment mode active" FontSize="11.5" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" />
                <Border Width="1" Height="12" Background="#1E293B" VerticalAlignment="Center" Margin="4,0" />
                <TextBlock Text="Single assessment tab active" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: App branding + Live Indian Standard Time (IST) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Klyro Secure Assessment Browser" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                <Border Width="1" Height="12" Background="#1E293B" VerticalAlignment="Center" />
                <!-- IST Live Clock -->
                <Border Background="#0C1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" ToolTipService.ToolTip="Indian Standard Time (UTC+05:30)">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterIstTimeText" Text="--:--:-- IST" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>

</Page>
