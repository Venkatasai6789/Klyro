{
  "application": {
    "name": "Klyro",
    "version": "1.0.0-dev",
    "environment": "Development"
  },
  "exam": {
    "provider": "CodeChef",
    "startUrl": "https://www.codechef.com/",
    "timerPolicy": "PauseDuringVerifiedNetworkFailure",
    "durationMinutes": 60
  },
  "network": {
    "portalUrl": "http://172.16.103.254:8090/",
    "probeIntervalMs": 2000,
    "probeTimeoutMs": 1000,
    "failureThreshold": 2,
    "recoveryTimeoutMs": 30000,
    "connectivityEndpoints": [
      "http://clients3.google.com/generate_204",
      "http://www.google.com/generate_204"
    ],
    "enableNetworkSimulator": true
  },
  "security": {
    "exitPin": "123456",
    "allowNewWindows": false,
    "allowNewTabs": false,
    "allowDownloads": false,
    "allowPrinting": false,
    "allowDevTools": true,
    "allowExternalProtocols": false,
    "strictNavigationAllowlist": true,
    "clipboardPolicy": "Allowed"
  },
  "browser": {
    "allowedOrigins": [
      "https://www.codechef.com",
      "https://codechef.com",
      "https://cdn.codechef.com",
      "https://campus.codechef.com",
      "https://discuss.codechef.com",
      "https://docs.google.com",
      "https://forms.gle",
      "https://forms.google.com",
      "https://accounts.google.com",
      "https://accounts.google.co.in",
      "https://myaccount.google.com",
      "https://myaccount.google.co.in",
      "https://ssl.gstatic.com",
      "https://fonts.googleapis.com",
      "https://fonts.gstatic.com",
      "https://www.gstatic.com",
      "https://apis.google.com",
      "https://accounts.youtube.com",
      "https://oauth2.googleapis.com",
      "https://lh3.googleusercontent.com",
      "https://lh4.googleusercontent.com",
      "https://lh5.googleusercontent.com",
      "https://lh6.googleusercontent.com",
      "http://localhost:5000"
    ],
    "recoveryAllowedOrigins": [
      "http://172.16.103.254:8090",
      "http://172.16.103.254",
      "http://localhost:8090"
    ]
  }
}
