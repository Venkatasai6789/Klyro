{
  "application": {
    "name": "Klyro",
    "version": "1.0.0",
    "environment": "Exam"
  },
  "exam": {
    "provider": "CodeChef",
    "contestId": "COOK142",
    "startUrl": "https://www.codechef.com/COOK142",
    "timerPolicy": "PauseDuringVerifiedNetworkFailure",
    "durationMinutes": 150
  },
  "network": {
    "portalUrl": "http://172.16.103.254:8090/",
    "probeIntervalMs": 3000,
    "probeTimeoutMs": 1500,
    "failureThreshold": 3,
    "recoveryTimeoutMs": 60000,
    "connectivityEndpoints": [
      "http://clients3.google.com/generate_204"
    ]
  },
  "security": {
    "allowNewWindows": false,
    "allowNewTabs": false,
    "allowDownloads": false,
    "allowPrinting": false,
    "allowDevTools": false,
    "allowExternalProtocols": false,
    "strictNavigationAllowlist": true,
    "clipboardPolicy": "Restricted"
  },
  "browser": {
    "allowedOrigins": [
      "https://www.codechef.com",
      "https://cdn.codechef.com",
      "https://campus.codechef.com"
    ],
    "recoveryAllowedOrigins": [
      "http://172.16.103.254:8090"
    ]
  }
}
